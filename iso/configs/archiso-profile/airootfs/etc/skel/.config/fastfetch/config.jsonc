{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "command-raw",
    "source": "/usr/local/bin/fastfetch-session logo",
    "padding": {
      "top": 2,
      "right": 5,
      "left": 2
    }
  },
  "display": {
    "separator": " 󰑃  ",
    "disableLinewrap": true
  },
  "modules": [
    "break",
    "break",
    {
      "type": "command",
      "key": " DISTRO",
      "keyColor": "yellow",
      "text": "/usr/local/bin/fastfetch-session distro"
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "yellow",
      "text": "/usr/local/bin/fastfetch-session branch"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "│ ├",
      "keyColor": "yellow",
      "text": "birth_install=$(stat -c %W /var/log 2>/dev/null || stat -c %W / 2>/dev/null || echo 0); case $birth_install in ''|0|-1) echo unknown;; *) current=$(date +%s); echo $(((current - birth_install) / 86400)) days;; esac"
    },
    {
      "type": "shell",
      "key": "│ └",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": " DE",
      "keyColor": "blue",
      "text": "/usr/local/bin/fastfetch-session de"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "blue",
      "text": "/usr/local/bin/fastfetch-session theme"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "blue"
    },
    {
      "type": "cursor",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "terminalfont",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ └",
      "keyColor": "blue"
    },
    {
      "type": "board",
      "key": "󰌢 SYSTEM",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├󰻑",
      "format": "{2}",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├󰍹",
      "keyColor": "green",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├󰾆",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "│ ├󰓡",
      "keyColor": "green"
    },
    {
      "type": "localip",
      "key": "│ ├󰩟",
      "compact": true,
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "│ └󰅐",
      "keyColor": "green"
    },
    {
      "type": "sound",
      "key": " AUDIO",
      "format": "{name} ({volume-percentage})",
      "keyColor": "magenta"
    },
    {
      "type": "player",
      "key": "│ ├󰥠",
      "keyColor": "magenta"
    },
    {
      "type": "media",
      "key": "│ └󰝚",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m  \u001b[39m    \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m  \u001b[90m "
    },
    "break"
  ]
}
