[
    {
        "name": "top-bar",
        "layer": "top",
        "position": "top",
        "height": 34,
        "spacing": 4,
        "modules-left": [
            "custom/distro",
            "hyprland/workspaces"
        ],
        "modules-center": [
            "hyprland/window"
        ],
        "modules-right": [
            "cpu",
            "memory",
            "wireplumber",
            "tray",
            "clock",
            "custom/power"
        ],
        "custom/distro": {
            "format": " 󰣇 HyprFrost ",
            "tooltip": false,
            "on-click": "rofi -show drun"
        },
        "hyprland/workspaces": {
            "disable-scroll": true,
            "all-outputs": true,
            "format": "{name}",
            "on-click": "activate"
        },
        "hyprland/window": {
            "format": "{}",
            "max-length": 50,
            "separate-outputs": true
        },
        "cpu": {
            "interval": 2,
            "format": "󰻠 {usage}%",
            "tooltip": false
        },
        "memory": {
            "interval": 2,
            "format": "󰍛 {percentage}%",
            "tooltip": false
        },
        "wireplumber": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟 Muted",
            "format-icons": ["", "", ""],
            "on-click": "pavucontrol"
        },
        "tray": {
            "icon-size": 16,
            "spacing": 8
        },
        "clock": {
            "format": "󰥔 {:%a %b %d  %I:%M %p}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
        },
        "custom/power": {
            "format": " ⏻ ",
            "tooltip": false,
            "on-click": "hyprctl dispatch exit"
        }
    },
    {
        "name": "bottom-dock",
        "layer": "top",
        "position": "bottom",
        "height": 36,
        "spacing": 6,
        "modules-left": [
            "custom/apps",
            "custom/kitty",
            "custom/thunar",
            "custom/brave",
            "custom/discord"
        ],
        "modules-center": [
            "wlr/taskbar"
        ],
        "modules-right": [],
        "custom/apps": {
            "format": " 󰣇 Apps ",
            "tooltip": false,
            "on-click": "rofi -show drun"
        },
        "custom/kitty": {
            "format": "  Kitty ",
            "tooltip": false,
            "on-click": "kitty"
        },
        "custom/thunar": {
            "format": "  Files ",
            "tooltip": false,
            "on-click": "thunar"
        },
        "custom/brave": {
            "format": " 󰈹 Brave ",
            "tooltip": false,
            "on-click": "brave"
        },
        "custom/discord": {
            "format": " 󰙯 Discord ",
            "tooltip": false,
            "on-click": "discord"
        },
        "wlr/taskbar": {
            "format": "{icon} {name}",
            "icon-size": 16,
            "tooltip-format": "{title}",
            "on-click": "activate",
            "on-click-middle": "close",
            "ignore-list": [
                "rofi"
            ]
        }
    }
]
