// Single unified top bar configuration for Hyprland / Waybar
[
    {
        "name": "top-bar",
        "layer": "top",
        "position": "top",
        "height": 38,
        "margin-top": 6,
        "margin-left": 12,
        "margin-right": 12,
        "spacing": 6,
        "modules-left": [
            "custom/brand",
            "hyprland/workspaces",
            "custom/term",
            "custom/files",
            "custom/web"
        ],
        "modules-center": [
            "clock",
            "custom/media"
        ],
        "modules-right": [
            "custom/clipboard",
            "custom/snip",
            "custom/keys",
            "cpu",
            "memory",
            "disk",
            "wireplumber",
            "network",
            "tray",
            "custom/power"
        ],
        "custom/brand": {
            "format": "󰣇",
            "tooltip": false,
            "on-click": "rofi -show drun"
        },
        "hyprland/workspaces": {
            "disable-scroll": true,
            "all-outputs": true,
            "format": "{name}",
            "on-click": "activate"
        },
        "custom/term": {
            "format": "󰞷",
            "tooltip-format": "Terminal (Kitty)",
            "on-click": "kitty"
        },
        "custom/files": {
            "format": "󰉋",
            "tooltip-format": "File Manager (Thunar)",
            "on-click": "thunar"
        },
        "custom/web": {
            "format": "󰈹",
            "tooltip-format": "Web Browser (Brave)",
            "on-click": "brave"
        },
        "clock": {
            "format": "󰥔  {:%a, %b %d • %I:%M %p}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "on-click": "notify-send 'Calendar' \"$(cal)\""
        },
        "custom/media": {
            "format": "󰎆",
            "tooltip": false,
            "on-click": "pavucontrol"
        },
        "custom/clipboard": {
            "format": "󰅍",
            "tooltip-format": "Clipboard History",
            "on-click": "/home/jacob/.local/bin/hypr-clipboard"
        },
        "custom/snip": {
            "format": "󰄀",
            "tooltip-format": "Screenshot Tool",
            "on-click": "/home/jacob/.local/bin/hypr-screenshot",
            "on-click-right": "/home/jacob/.local/bin/hypr-screenshot config"
        },
        "custom/keys": {
            "format": "󰌌",
            "tooltip-format": "Show Shortcuts",
            "on-click": "notify-send 'Keybinds' 'Super+Return: Terminal\nSuper+Space: App Launcher\nSuper+E: Files\nSuper+B: Browser\nSuper+C: Close Window\nSuper+Shift+Q: Exit'"
        },
        "cpu": {
            "interval": 2,
            "format": "󰻠 {usage}%",
            "tooltip": false,
            "on-click": "kitty -e btop"
        },
        "memory": {
            "interval": 2,
            "format": "󰍛 {percentage}%",
            "tooltip": false,
            "on-click": "kitty -e btop"
        },
        "disk": {
            "interval": 30,
            "format": "󰋊 {percentage_used}%",
            "path": "/",
            "on-click": "kitty -e df -h"
        },
        "wireplumber": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟 Muted",
            "format-icons": ["", "", ""],
            "on-click": "pavucontrol"
        },
        "network": {
            "format-ethernet": "󰈀",
            "format-wifi": "󰖩",
            "format-disconnected": "󰈂",
            "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
            "on-click": "nm-connection-editor"
        },
        "tray": {
            "icon-size": 16,
            "spacing": 6
        },
        "custom/power": {
            "format": " ⏻ ",
            "tooltip": false,
            "on-click": "hyprctl dispatch exit"
        }
    }
]
