[
    {
        "name": "top-bar",
        "layer": "top",
        "position": "top",
        "height": 34,
        "margin-top": 6,
        "margin-left": 12,
        "margin-right": 12,
        "spacing": 4,
        "modules-left": [
            "custom/brand",
            "hyprland/workspaces",
            "hyprland/window"
        ],
        "modules-center": [
            "clock",
            "custom/media"
        ],
        "modules-right": [
            "cpu",
            "memory",
            "wireplumber",
            "network",
            "custom/antigravity",
            "custom/power"
        ],
        "custom/brand": {
            "format": "󰣇  HyprFrost",
            "tooltip": false,
            "on-click": "hyprfrost-welcome"
        },
        "hyprland/workspaces": {
            "disable-scroll": true,
            "all-outputs": true,
            "format": "{name}",
            "on-click": "activate"
        },
        "hyprland/window": {
            "format": "{}",
            "max-length": 40,
            "separate-outputs": true
        },
        "clock": {
            "format": "󰥔  {:%a %b %d  %I:%M %p}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
        },
        "custom/media": {
            "format": "󰎆  Media",
            "tooltip": false,
            "on-click": "pavucontrol"
        },
        "cpu": {
            "interval": 2,
            "format": "󰻠 {usage}%",
            "tooltip": false
        },
        "memory": {
            "interval": 2,
            "format": "󰍛 {percentage}%",
            "tooltip": false
        },
        "disk": {
            "interval": 30,
            "format": "󰋊 {percentage_used}%",
            "path": "/"
        },
        "wireplumber": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟 Muted",
            "format-icons": ["", "", ""],
            "on-click": "pavucontrol"
        },
        "network": {
            "format-ethernet": "󰈀",
            "format-wifi": "",
            "format-disconnected": "󰈂",
            "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
            "on-click": "nm-connection-editor"
        },
        "custom/antigravity": {
            "format": "󰚩",
            "tooltip": false,
            "on-click": "antigravity"
        },
        "tray": {
            "icon-size": 15,
            "spacing": 8
        },
        "custom/power": {
            "format": " ⏻ ",
            "tooltip": false,
            "on-click": "hyprctl dispatch exit"
        }
    },
    {
        "name": "bottom-dock",
        "layer": "top",
        "position": "bottom",
        "height": 44,
        "margin-bottom": 6,
        "margin-left": 12,
        "margin-right": 12,
        "spacing": 6,
        "modules-left": [
            "custom/start",
            "custom/search"
        ],
        "modules-center": [],
        "modules-right": [
            "custom/clipboard",
            "custom/snip",
            "custom/keys",
            "custom/showdesktop"
        ],
        "custom/start": {
            "format": "󰣇  Start",
            "tooltip": false,
            "on-click": "rofi -show drun"
        },
        "custom/search": {
            "format": "󰍏  Search apps...",
            "tooltip": false,
            "on-click": "rofi -show drun"
        },
        "wlr/taskbar": {
            "format": "{icon}",
            "icon-size": 22,
            "tooltip-format": "{title}",
            "on-click": "activate",
            "on-click-middle": "close",
            "ignore-list": [
                "rofi"
            ]
        },
        "custom/clipboard": {
            "format": "󰅍  Clipboard",
            "tooltip": false,
            "on-click": "cliphist list | rofi -dmenu | cliphist decode | wl-copy"
        },
        "custom/snip": {
            "format": "󰄀  Snip",
            "tooltip": false,
            "on-click": "/home/jacob/.local/bin/hypr-screenshot area"
        },
        "custom/keys": {
            "format": "󰌌  Keys",
            "tooltip": false,
            "on-click": "notify-send 'Keybinds' 'Super+Return: Terminal\nSuper+Space: App Launcher\nSuper+E: Files\nSuper+B: Browser\nSuper+C: Close Window\nSuper+Shift+Q: Exit'"
        },
        "custom/showdesktop": {
            "format": " ",
            "tooltip": false,
            "on-click": "hyprctl dispatch workspace special:magic"
        }
    }
]
