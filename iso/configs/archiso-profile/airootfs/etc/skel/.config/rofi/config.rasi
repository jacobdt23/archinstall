/**
 * HyprFrost Rofi Master Configuration
 **/

configuration {
    modes:                      [ drun, run ];
    show-icons:                 true;
    display-drun:               " 󰣇  Launcher ";
    display-run:                "   Run ";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 11";
}

@theme "~/.config/rofi/theme.rasi"
