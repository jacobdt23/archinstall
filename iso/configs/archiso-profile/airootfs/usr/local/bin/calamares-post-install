#!/bin/bash
set -e

# 1. Ensure /boot exists, is strictly uncompressed (chattr +m), and restore kernel + microcode
mkdir -p /boot
chattr -R +m /boot 2>/dev/null || true
chattr +m /boot 2>/dev/null || true
btrfs property set /boot compression none 2>/dev/null || true

KVER="$(ls -1 /usr/lib/modules 2>/dev/null | head -n1)"
if [ -n "$KVER" ] && [ -f "/usr/lib/modules/$KVER/vmlinuz" ]; then
    cp -f "/usr/lib/modules/$KVER/vmlinuz" /boot/vmlinuz-linux
    chattr +m /boot/vmlinuz-linux 2>/dev/null || true
    btrfs property set /boot/vmlinuz-linux compression none 2>/dev/null || true
fi

if [ -d /usr/lib/boot-backup ]; then
    cp -f /usr/lib/boot-backup/*-ucode.img /boot/ 2>/dev/null || true
    chattr -R +m /boot 2>/dev/null || true
fi

# 2. Configure early NVIDIA KMS when an NVIDIA GPU is present on target hardware
has_nvidia=0
if command -v lspci >/dev/null 2>&1 && lspci 2>/dev/null | grep -qi 'nvidia'; then
    has_nvidia=1
elif grep -qi '0x10de' /sys/bus/pci/devices/*/vendor 2>/dev/null; then
    has_nvidia=1
fi

if [ "$has_nvidia" -eq 1 ]; then
    mkdir -p /etc/modprobe.d /etc/mkinitcpio.conf.d
    cat > /etc/modprobe.d/nvidia.conf << 'EOF'
options nvidia_drm modeset=1 fbdev=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1
EOF
    cat > /etc/mkinitcpio.conf.d/nvidia.conf << 'EOF'
MODULES+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
EOF
    for unit in nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service; do
        if [ -f "/usr/lib/systemd/system/$unit" ]; then
            systemctl enable "$unit" 2>/dev/null || true
        fi
    done
else
    rm -f /etc/mkinitcpio.conf.d/nvidia.conf
fi

# Replace archiso mkinitcpio preset & hook config with standard installed Arch Linux preset
rm -rf /etc/mkinitcpio.conf.d/archiso.conf
mkdir -p /etc/mkinitcpio.d
cat > /etc/mkinitcpio.d/linux.preset << 'EOF'
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux.img"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
EOF

mkinitcpio -P
chattr -R +m /boot 2>/dev/null || true
btrfs filesystem defragment -r -v /boot 2>/dev/null || true
sync

# 3. Clean up live-ISO specific systemd units, autologin, and live user
rm -rf /etc/systemd/system/getty@tty1.service.d
rm -rf /etc/systemd/system/etc-pacman.d-gnupg.mount
rm -f /etc/systemd/system/pacman-init.service \
      /etc/systemd/system/choose-mirror.service \
      /etc/systemd/system/livecd-alsa-unmuter.service \
      /etc/systemd/system/livecd-talk.service \
      /etc/systemd/system/multi-user.target.wants/pacman-init.service \
      /etc/systemd/system/multi-user.target.wants/choose-mirror.service \
      /etc/systemd/system/multi-user.target.wants/livecd-talk.service \
      /etc/systemd/system/sound.target.wants/livecd-alsa-unmuter.service
rm -f /etc/systemd/journald.conf.d/volatile-storage.conf \
      /etc/systemd/logind.conf.d/do-not-suspend.conf \
      /etc/systemd/resolved.conf.d/archiso.conf \
      /etc/systemd/system-generators/systemd-gpt-auto-generator \
      /etc/ssh/sshd_config.d/10-archiso.conf
rm -f /root/.zlogin /root/.automated_script.sh /root/customize_airootfs.sh
rm -rf /root/.config

rm -f /etc/sudoers.d/10-live-nopasswd \
      /etc/sddm.conf.d/10-live-autologin.conf
if id -u orbit >/dev/null 2>&1; then
    userdel -r orbit 2>/dev/null || rm -rf /home/orbit
fi

# Generate a unique per-machine pacman keyring
rm -rf /etc/pacman.d/gnupg
pacman-key --init 2>/dev/null || true
pacman-key --populate archlinux 2>/dev/null || true

# 4. Enable runtime services
systemctl enable NetworkManager.service bluetooth.service sddm.service systemd-oomd.service 2>/dev/null || true
systemctl mask NetworkManager-wait-online.service systemd-networkd-wait-online.service 2>/dev/null || true

# 5. Configure SDDM default session to Orbit Desktop (Hyprland)
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-orbit.conf << 'EOF'
[Theme]
CursorTheme=Adwaita

[General]
DisplayServer=wayland
HaltCommand=/usr/bin/systemctl poweroff
RebootCommand=/usr/bin/systemctl reboot
EOF

# 6. Pre-configure Timeshift in BTRFS mode + timeshift-autosnap + grub-btrfs when installed on Btrfs
ROOT_DEV="$(findmnt -no SOURCE / 2>/dev/null | sed 's/\[.*//' || true)"
ROOT_FSTYPE="$(findmnt -no FSTYPE / 2>/dev/null || true)"
ROOT_UUID="$(findmnt -no UUID / 2>/dev/null || true)"
if [ -z "$ROOT_UUID" ] && [ -n "$ROOT_DEV" ]; then
    ROOT_UUID="$(blkid -s UUID -o value "$ROOT_DEV" 2>/dev/null || true)"
fi
if [ "$ROOT_FSTYPE" = "btrfs" ] && [ -n "$ROOT_UUID" ]; then
    mkdir -p /etc/timeshift
    cat > /etc/timeshift/timeshift.json << EOF
{
  "backup_device_uuid" : "${ROOT_UUID}",
  "parent_device_uuid" : "",
  "do_first_run" : "false",
  "btrfs_mode" : "true",
  "include_btrfs_home_for_backup" : "false",
  "include_btrfs_home_for_restore" : "false",
  "stop_cron_emails" : "true",
  "schedule_monthly" : "false",
  "schedule_weekly" : "true",
  "schedule_daily" : "true",
  "schedule_hourly" : "false",
  "schedule_boot" : "true",
  "count_monthly" : "2",
  "count_weekly" : "3",
  "count_daily" : "5",
  "count_hourly" : "6",
  "count_boot" : "3",
  "snapshot_size" : "0",
  "snapshot_count" : "0",
  "date_format" : "%Y-%m-%d %H:%M:%S",
  "exclude" : [],
  "exclude-apps" : []
}
EOF

    if [ -f /etc/timeshift-autosnap.conf ]; then
        sed -i 's/^updateGrub=.*/updateGrub=false/' /etc/timeshift-autosnap.conf
        sed -i 's/^minHoursBetweenSnapshots=.*/minHoursBetweenSnapshots=0/' /etc/timeshift-autosnap.conf
    fi

    mkdir -p /etc/pacman.d/hooks
    cat > /etc/pacman.d/hooks/00-timeshift-autosnap.hook << 'HOOK_EOF'
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Creating Timeshift snapshot before pacman transaction...
Depends = timeshift
When = PreTransaction
Exec = /usr/bin/timeshift-autosnap
AbortOnFail
HOOK_EOF

    systemctl enable grub-btrfsd.service 2>/dev/null || true
else
    systemctl disable grub-btrfsd.service 2>/dev/null || true
fi

# 7. Configure GRUB distributor and grub-btrfs snapshot branding
if [ -f /etc/default/grub ]; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Orbit OS"/' /etc/default/grub
fi
if [ -f /etc/default/grub-btrfs/config ]; then
    sed -i 's/^#*GRUB_BTRFS_SUBMENUNAME=.*/GRUB_BTRFS_SUBMENUNAME="Orbit OS Snapshots"/' /etc/default/grub-btrfs/config
fi

systemctl enable keyd.service 2>/dev/null || true

# 8. Strip build-only local customrepo from /etc/pacman.conf on installed target
sed -i '/^\[customrepo\]/,/^Server =/d' /etc/pacman.conf

# 9. Remove live installer configuration and launcher from the installed system
rm -rf /etc/calamares
rm -f /usr/share/applications/calamares.desktop \
      /usr/local/bin/launch-calamares
