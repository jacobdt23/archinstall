#!/bin/bash
set -e

# 1. Ensure /boot exists, is strictly uncompressed (chattr +m), and restore kernel + microcode
mkdir -p /boot
chattr -R +m /boot 2>/dev/null || true
chattr +m /boot 2>/dev/null || true
btrfs property set /boot compression none 2>/dev/null || true

KVER="$(ls -1 /usr/lib/modules 2>/dev/null | head -n1)"
if [ -n "$KVER" ] && [ -f "/usr/lib/modules/$KVER/vmlinuz" ]; then
    cp -f "/usr/lib/modules/$KVER/vmlinuz" /boot/vmlinuz-linux
    chattr +m /boot/vmlinuz-linux 2>/dev/null || true
    btrfs property set /boot/vmlinuz-linux compression none 2>/dev/null || true
fi

# Restore CPU microcode if backed up
if [ -d /usr/lib/boot-backup ]; then
    cp -f /usr/lib/boot-backup/*-ucode.img /boot/ 2>/dev/null || true
    chattr -R +m /boot 2>/dev/null || true
fi

# 2. Replace archiso mkinitcpio preset & hook config with standard installed Arch Linux preset
rm -rf /etc/mkinitcpio.conf.d/archiso.conf
mkdir -p /etc/mkinitcpio.d
cat > /etc/mkinitcpio.d/linux.preset << 'EOF'
# mkinitcpio preset file for the 'linux' package
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux.img"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
EOF

# Ensure initramfs is fully built, uncompressed, and synced to disk
mkinitcpio -P
chattr -R +m /boot 2>/dev/null || true
btrfs filesystem defragment -r -v /boot 2>/dev/null || true
sync

# 3. Clean up live-ISO specific systemd units, autologin, and root autostart scripts
rm -rf /etc/systemd/system/getty@tty1.service.d
rm -rf /etc/systemd/system/etc-pacman.d-gnupg.mount
rm -f /etc/systemd/system/pacman-init.service \
      /etc/systemd/system/choose-mirror.service \
      /etc/systemd/system/livecd-alsa-unmuter.service \
      /etc/systemd/system/livecd-talk.service \
      /etc/systemd/system/multi-user.target.wants/pacman-init.service \
      /etc/systemd/system/multi-user.target.wants/choose-mirror.service \
      /etc/systemd/system/multi-user.target.wants/livecd-talk.service \
      /etc/systemd/system/sound.target.wants/livecd-alsa-unmuter.service
rm -f /etc/systemd/journald.conf.d/volatile-storage.conf \
      /etc/systemd/logind.conf.d/do-not-suspend.conf \
      /etc/systemd/resolved.conf.d/archiso.conf \
      /etc/systemd/system-generators/systemd-gpt-auto-generator \
      /etc/ssh/sshd_config.d/10-archiso.conf
rm -f /root/.zlogin /root/.automated_script.sh
rm -rf /root/.config

# 4. Set default shell to fish for root and future users
if [ -f /etc/default/useradd ]; then
    sed -i 's|^SHELL=.*|SHELL=/usr/bin/fish|' /etc/default/useradd
fi
chsh -s /usr/bin/fish root 2>/dev/null || true

# 5. Configure SDDM default session to Hyprland
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-session.conf << 'EOF'
[Autologin]
Session=hyprland

[General]
HaltCommand=/usr/bin/systemctl poweroff
RebootCommand=/usr/bin/systemctl reboot
EOF

# 6. Pre-configure Timeshift in BTRFS mode + timeshift-autosnap + grub-btrfs when installed on Btrfs
ROOT_DEV="$(findmnt -no SOURCE / 2>/dev/null | sed 's/\[.*//' || true)"
ROOT_FSTYPE="$(findmnt -no FSTYPE / 2>/dev/null || true)"
ROOT_UUID="$(findmnt -no UUID / 2>/dev/null || true)"
if [ -z "$ROOT_UUID" ] && [ -n "$ROOT_DEV" ]; then
    ROOT_UUID="$(blkid -s UUID -o value "$ROOT_DEV" 2>/dev/null || true)"
fi
if [ "$ROOT_FSTYPE" = "btrfs" ] && [ -n "$ROOT_UUID" ]; then
    mkdir -p /etc/timeshift
    cat > /etc/timeshift/timeshift.json << EOF
{
  "backup_device_uuid" : "${ROOT_UUID}",
  "parent_device_uuid" : "",
  "do_first_run" : "false",
  "btrfs_mode" : "true",
  "include_btrfs_home" : "false",
  "stop_cron_emails" : "true",
  "schedule_monthly" : "false",
  "schedule_weekly" : "true",
  "schedule_daily" : "true",
  "schedule_hourly" : "false",
  "schedule_boot" : "true",
  "count_monthly" : "2",
  "count_weekly" : "3",
  "count_daily" : "5",
  "count_hourly" : "6",
  "count_boot" : "3",
  "snapshot_size" : "0",
  "snapshot_count" : "0",
  "exclude" : [],
  "exclude-apps" : []
}
EOF
fi

# 7. Strip build-only local customrepo from /etc/pacman.conf on installed target
sed -i '/^\[customrepo\]/,/^Server =/d' /etc/pacman.conf

# 8. Remove live installer configuration and launcher from the installed system
rm -rf /etc/calamares
rm -f /usr/share/applications/calamares.desktop \
      /usr/local/bin/launch-calamares
