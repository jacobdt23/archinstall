# Keybinds popup & Welcome Center
# ----------------------------------------------------------------------------
def keybind_row(key, desc):
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    add_class(row, "row")
    row.pack_start(add_class(make_label(key), "key"), False, False, 0)
    row.pack_end(make_label(desc, ellipsize=True), False, False, 0)
    return row


class KeybindsPopup(Popup):
    def __init__(self, shell):
        super().__init__(shell, "keybinds", anchors=(E.BOTTOM, E.RIGHT), margins={E.BOTTOM: 60, E.RIGHT: 80},
                         keyboard=GtkLayerShell.KeyboardMode.EXCLUSIVE)
        card = card_box(10, 16)
        add_class(card, "card", "card-yellow")
        card.set_size_request(520, 500)
        self.add(card)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.pack_start(add_class(make_label(G_KEY), "glyph"), False, False, 0)
        head.pack_start(make_label("Keybindings Reference", "title"), False, False, 0)
        card.pack_start(head, False, False, 0)
        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text("Search keybinds...")
        self.entry.connect("changed", lambda *_: self.listbox.invalidate_filter())
        card.pack_start(self.entry, False, False, 0)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.set_filter_func(self._filter)
        self.data = {}
        for key, desc in KEYBINDS:
            row = Gtk.ListBoxRow()
            row.add(keybind_row(key, desc))
            self.data[row] = f"{key} {desc}".lower()
            self.listbox.add(row)
        card.pack_start(scrolled(self.listbox), True, True, 0)

    def _filter(self, row):
        q = self.entry.get_text().strip().lower()
        return not q or q in self.data.get(row, "")

    def on_open(self):
        self.entry.set_text("")

    def open_popup(self):
        super().open_popup()
        self.entry.grab_focus()


class WelcomeCenter(Popup):
    def __init__(self, shell):
        super().__init__(shell, "welcome", anchors=(E.TOP, E.BOTTOM, E.LEFT, E.RIGHT),
                         keyboard=GtkLayerShell.KeyboardMode.EXCLUSIVE)
        GtkLayerShell.set_exclusive_zone(self, -1)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self._on_backdrop)

        outer = Gtk.Box()
        self.add(outer)
        self.card = card_box(12, 20)
        add_class(self.card, "card", "card-blue", "card-welcome")
        self.card.set_size_request(780, 550)
        self.card.set_halign(Gtk.Align.CENTER)
        self.card.set_valign(Gtk.Align.CENTER)
        outer.pack_start(self.card, True, False, 0)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        head.pack_start(make_icon(LOGO, 42), False, False, 0)
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        titles.pack_start(add_class(make_label("Welcome to Jacob's Custom Arch Linux"), "title"), False, False, 0)
        sub = make_label("Hyprland + Python/GTK Shell (TokyoNight) • Btrfs + Timeshift Rollback • UEFI & BIOS Ready", "muted")
        titles.pack_start(sub, False, False, 0)
        head.pack_start(titles, False, False, 0)
        head.pack_end(flat_button("✕", "pill", "btn-red", cb=self.close_popup), False, False, 0)
        self.card.pack_start(head, False, False, 0)

        tabs = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10, homogeneous=True)
        self.tab_btns = [
            flat_button("🚀  First-Boot Essential Apps", "tab", cb=lambda: self.set_tab(0)),
            flat_button("⌨️  Keybindings Cheat Sheet", "tab", cb=lambda: self.set_tab(1)),
        ]
        for b in self.tab_btns:
            tabs.pack_start(b, True, True, 0)
        self.card.pack_start(tabs, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.add_named(self._apps_page(), "apps")
        self.stack.add_named(self._keys_page(), "keys")
        self.card.pack_start(self.stack, True, True, 0)
        self.card.pack_start(hline(), False, False, 0)

        foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.autostart = Gtk.CheckButton(label="Show Welcome on Startup")
        self.autostart.set_active(not os.path.exists(WELCOME_FLAG))
        self.autostart.connect("toggled", self._on_autostart)
        foot.pack_start(self.autostart, False, False, 0)
        foot.pack_end(make_label("Tip: Press SUPER + W anytime to reopen this hub • TAB switches tabs • ESC closes", "muted"),
                      False, False, 0)
        self.card.pack_start(foot, False, False, 0)
        self.set_tab(0)

    def _apps_page(self):
        grid = Gtk.Grid(column_spacing=10, row_spacing=8, column_homogeneous=True)
        for i, (title, subtitle, icon, cmd) in enumerate(get_essential_apps()):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            row.pack_start(make_icon(icon, 32), False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            text.pack_start(make_label(title, "row-title", ellipsize=True), False, False, 0)
            text.pack_start(make_label(subtitle, "row-desc", ellipsize=True), False, False, 0)
            row.pack_start(text, True, True, 0)
            row.pack_end(add_class(make_label("Open", xalign=0.5), "btn-open"), False, False, 0)
            grid.attach(flat_button(row, "row", cb=lambda c=cmd: (self.close_popup(), spawn(c))), i % 2, i // 2, 1, 1)
        return grid

    def _keys_page(self):
        grid = Gtk.Grid(column_spacing=10, row_spacing=6, column_homogeneous=True)
        for i, (key, desc) in enumerate(get_keybinds()):
            grid.attach(keybind_row(key, desc), i % 2, i // 2, 1, 1)
        return scrolled(grid, height=300)

    def set_tab(self, idx):
        self.stack.set_visible_child_name("apps" if idx == 0 else "keys")
        self.tab = idx
        for i, b in enumerate(self.tab_btns):
            ctx = b.get_style_context()
            (ctx.add_class if i == idx else ctx.remove_class)("tab-active")

    def handle_key(self, ev):
        if ev.keyval == Gdk.KEY_Tab:
            self.set_tab(1 - self.tab)
            return True
        return False

    def _on_backdrop(self, _w, ev):
        a = self.card.get_allocation()
        if not (a.x <= ev.x <= a.x + a.width and a.y <= ev.y <= a.y + a.height):
            self.close_popup()
        return False

    def _on_autostart(self, btn):
        try:
            if btn.get_active():
                if os.path.exists(WELCOME_FLAG):
                    os.remove(WELCOME_FLAG)
            else:
                os.makedirs(os.path.dirname(WELCOME_FLAG), exist_ok=True)
                open(WELCOME_FLAG, "w").close()
        except OSError:
            pass


# ----------------------------------------------------------------------------
# Desktop Surface & Context Menu
# ----------------------------------------------------------------------------
class DesktopSurface(Layer):
    """Transparent background layer catching clicks on the desktop wallpaper."""

    def __init__(self, shell, monitor):
        super().__init__("desktop", GtkLayerShell.Layer.BOTTOM,
                         (E.TOP, E.BOTTOM, E.LEFT, E.RIGHT),
                         keyboard=GtkLayerShell.KeyboardMode.NONE,
                         exclusive=False, monitor=monitor)
        self.shell = shell
        self.monitor = monitor
        eb = Gtk.EventBox()
        eb.set_visible_window(False)
        eb.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        eb.connect("button-press-event", self._on_click)
        self.add(eb)

    def _on_click(self, _w, ev):
        if ev.button == 3:  # Right Click
            self.shell.show_context_menu(self.monitor, ev.x, ev.y)
            return True
        elif ev.button == 1:  # Left Click
            self.shell.close_all()
            return True
        return False


class ContextMenu(Popup):
    """Windows 11 styled desktop right-click context menu."""

    def __init__(self, shell):
        super().__init__(shell, "contextmenu", anchors=(E.TOP, E.LEFT),
                         keyboard=GtkLayerShell.KeyboardMode.ON_DEMAND)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        add_class(card, "card", "card-context")
        card.set_size_request(260, -1)
        self.add(card)

        def add_item(glyph, label, cmd=None, cb=None, accent=False):
            def on_click():
                self.close_popup()
                if cb:
                    cb()
                elif cmd:
                    spawn(cmd)

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            lbl_glyph = make_label(glyph)
            add_class(lbl_glyph, "menu-icon")
            row.pack_start(lbl_glyph, False, False, 0)

            lbl_title = make_label(label, "row-title")
            row.pack_start(lbl_title, True, True, 0)

            cls = "menu-item-accent" if accent else "menu-item"
            btn = flat_button(row, "row", cls, cb=on_click)
            card.pack_start(btn, False, False, 1)

        # 1. View / Sort / Refresh (Exact Windows 11 Desktop Context Menu)
        add_item("\U000F0208", "View", cb=lambda: self.shell.toggle("keybinds"))
        add_item("\U000F04B3", "Sort by", cmd="hyprctl dispatch focuswindow next")
        add_item("\U000F0450", "Refresh", cmd="sh -c 'hyprctl reload && notify-send \"Desktop\" \"Refreshed!\"'")

        card.pack_start(hline(), False, False, 3)

        # 2. File creation (New Folder / New Document)
        def create_folder():
            desktop_dir = os.path.expanduser("~/Desktop")
            os.makedirs(desktop_dir, exist_ok=True)
            for i in range(1, 100):
                path = os.path.join(desktop_dir, f"New Folder" if i == 1 else f"New Folder ({i})")
                if not os.path.exists(path):
                    os.makedirs(path)
                    spawn(f"notify-send 'Desktop' 'Created {os.path.basename(path)}'")
                    break

        def create_doc():
            desktop_dir = os.path.expanduser("~/Desktop")
            os.makedirs(desktop_dir, exist_ok=True)
            for i in range(1, 100):
                path = os.path.join(desktop_dir, f"New Text Document.txt" if i == 1 else f"New Text Document ({i}).txt")
                if not os.path.exists(path):
                    open(path, "w").close()
                    spawn(f"notify-send 'Desktop' 'Created {os.path.basename(path)}'")
                    break

        add_item("\U000F024B", "New Folder", cb=create_folder)
        add_item("\U000F0219", "New Text Document", cb=create_doc)

        card.pack_start(hline(), False, False, 3)

        # 3. Open in Terminal / Open in Files / Take Screenshot
        add_item("\U000F04F2", "Open in Terminal", cmd="kitty")
        add_item("\U000F024B", "Open in Files", cmd="thunar")
        add_item("󰄀", "Take Screenshot", cmd="/home/jacob/.local/bin/hypr-screenshot menu")

        card.pack_start(hline(), False, False, 3)

        # 4. Display Settings & Personalize (Windows 11)
        add_item("\U000F0379", "Display settings", cmd="/home/jacob/.local/bin/hypr-settings")
        add_item("\U000F03E8", "Personalize", cmd="/home/jacob/.local/bin/hypr-settings")

        card.pack_start(hline(), False, False, 3)

        # 5. Show more options (Settings)
        add_item("\U000F0493", "Show more options", cb=lambda: self.shell.toggle("controlcenter"), accent=True)


class AppContextMenu(Popup):
    """Windows 11 style taskbar app context menu (Pin / Unpin / New Window / Close)."""

    def __init__(self, shell):
        super().__init__(shell, "appcontextmenu", anchors=(E.TOP, E.LEFT),
                         keyboard=GtkLayerShell.KeyboardMode.ON_DEMAND)
        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        add_class(self.card, "card", "card-context")
        self.card.set_size_request(250, -1)
        self.add(self.card)

    def populate(self, app, is_pinned=True):
        for c in self.card.get_children():
            self.card.remove(c)

        name = app.get("name", "Application")
        icon_path = app.get("icon", LOGO)
        desktop_id = app.get("desktop_id", "")
        cmd = app.get("cmd") or f"gtk-launch '{desktop_id}' || gio launch '/usr/share/applications/{desktop_id}.desktop'"

        # Header with app icon and title
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        head.pack_start(make_icon(icon_path, 22), False, False, 0)
        t_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        t_box.pack_start(make_label(name, "row-title", ellipsize=True), False, False, 0)
        sub = "Pinned to taskbar" if is_pinned else "Desktop Application"
        t_box.pack_start(make_label(sub, "muted"), False, False, 0)
        head.pack_start(t_box, True, True, 0)
        self.card.pack_start(head, False, False, 4)
        self.card.pack_start(hline(), False, False, 3)

        # 1. Launch / New window
        def on_launch():
            self.close_popup()
            spawn(cmd)

        row_launch = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row_launch.pack_start(make_label("\U000F0054", "menu-icon"), False, False, 0)
        row_launch.pack_start(make_label("New window", "row-title"), True, True, 0)
        self.card.pack_start(flat_button(row_launch, "row", "menu-item", cb=on_launch), False, False, 1)

        self.card.pack_start(hline(), False, False, 3)

        # 2. Pin / Unpin from taskbar (Windows 11)
        if is_pinned:
            def on_unpin():
                self.close_popup()
                self.shell.unpin_app(desktop_id)
            row_pin = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row_pin.pack_start(make_label("\U000F0403", "menu-icon"), False, False, 0)
            row_pin.pack_start(make_label("Unpin from taskbar", "row-title"), True, True, 0)
            self.card.pack_start(flat_button(row_pin, "row", "menu-item", cb=on_unpin), False, False, 1)
        else:
            def on_pin():
                self.close_popup()
                self.shell.pin_app(app)
            row_pin = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row_pin.pack_start(make_label("\U000F0403", "menu-icon"), False, False, 0)
            row_pin.pack_start(make_label("Pin to taskbar", "row-title"), True, True, 0)
            self.card.pack_start(flat_button(row_pin, "row", "menu-item-accent", cb=on_pin), False, False, 1)

        # 3. Close window
        def on_close():
            self.close_popup()
            spawn(f"hyprctl dispatch closewindow class:{desktop_id}")
        row_close = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row_close.pack_start(make_label("\U000F0156", "menu-icon"), False, False, 0)
        row_close.pack_start(make_label("Close window", "row-title"), True, True, 0)
        self.card.pack_start(flat_button(row_close, "row", "menu-item", cb=on_close), False, False, 1)

        self.card.show_all()


class TaskbarContextMenu(Popup):
    """Windows 11 style taskbar context menu."""

    def __init__(self, shell):
        super().__init__(shell, "taskbarmenu", anchors=(E.TOP, E.LEFT),
                         keyboard=GtkLayerShell.KeyboardMode.ON_DEMAND)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        add_class(card, "card", "card-context")
        card.set_size_request(240, -1)
        self.add(card)

        # Header
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.pack_start(make_icon(LOGO, 16), False, False, 0)
        head.pack_start(make_label("Taskbar Settings", "row-title"), True, True, 0)
        card.pack_start(head, False, False, 4)
        card.pack_start(hline(), False, False, 3)

        def add_item(glyph, label, cmd=None, cb=None):
            def on_click():
                self.close_popup()
                if cb:
                    cb()
                elif cmd:
                    spawn(cmd)
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.pack_start(make_label(glyph, "menu-icon"), False, False, 0)
            row.pack_start(make_label(label, "row-title"), True, True, 0)
            card.pack_start(flat_button(row, "row", "menu-item", cb=on_click), False, False, 1)

        add_item("\U000F0493", "Taskbar Settings", cmd="/home/jacob/.local/bin/hypr-settings")
        add_item("\U000F03E8", "Personalize Colors", cmd="/home/jacob/.local/bin/hypr-settings")
        card.pack_start(hline(), False, False, 3)
        add_item("\U000F0450", "Refresh Taskbar", cmd="sh -c 'hyprctl reload && notify-send \"Taskbar\" \"Refreshed!\"'")


# ----------------------------------------------------------------------------
# Shell controller
# ----------------------------------------------------------------------------
class Shell:
    def __init__(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_USER)
        self.history = []
        self.cc_proc = None
        self.pinned_apps = self.load_pinned_apps()
        self.docks = []

        display = Gdk.Display.get_default()
        self.bars = []
        self.desktops = []
        for i in range(max(display.get_n_monitors(), 1)):
            mon = display.get_monitor(i)
            bar = TopBar(self, mon, i)
            dock = BottomDock(self, mon)
            desk = DesktopSurface(self, mon)
            bar.show_all()
            dock.show_all()
            desk.show_all()
            self.bars.append(bar)
            self.docks.append(dock)
            self.desktops.append(desk)

        self.popups = {
            "launcher": Launcher(self),
            "power": PowerMenu(self),
            "calendar": CalendarPopup(self),
            "clipboard": ClipboardPopup(self),
            "keybinds": KeybindsPopup(self),
            "notifications": NotificationCenter(self),
            "media": MediaPopup(self),
            "welcome": WelcomeCenter(self),
            "contextmenu": ContextMenu(self),
            "appcontextmenu": AppContextMenu(self),
            "taskbarmenu": TaskbarContextMenu(self),
        }
        self.notifier = NotificationDaemon(self)
        self._start_ipc()
        self._start_cpp_monitor()
        if not os.path.exists(WELCOME_FLAG):
            GLib.timeout_add(1500, lambda: (self.toggle("welcome"), False)[-1])

    def load_pinned_apps(self):
        if os.path.exists(DOCK_CONFIG):
            try:
                with open(DOCK_CONFIG, "r") as f:
                    data = json.load(f)
                    if isinstance(data, list) and len(data) > 0:
                        return data
            except Exception:
                pass
        return list(DEFAULT_PINNED_APPS)

    def save_pinned_apps(self):
        try:
            os.makedirs(os.path.dirname(DOCK_CONFIG), exist_ok=True)
            with open(DOCK_CONFIG, "w") as f:
                json.dump(self.pinned_apps, f, indent=2)
        except Exception as e:
            print(f"Error saving pinned apps: {e}", file=sys.stderr)

    def pin_app(self, app_data):
        did = app_data.get("desktop_id")
        if not did:
            return
        if not any(a.get("desktop_id") == did for a in self.pinned_apps):
            self.pinned_apps.append({
                "name": app_data.get("name", did),
                "desktop_id": did,
                "icon": app_data.get("icon", LOGO),
                "cmd": app_data.get("cmd", f"gtk-launch '{did}'"),
            })
            self.save_pinned_apps()
            self.refresh_docks()
            name = app_data.get("name", did)
            spawn(f"notify-send 'Taskbar' 'Pinned {name} to taskbar'")

    def unpin_app(self, desktop_id):
        name = desktop_id
        for a in self.pinned_apps:
            if a.get("desktop_id") == desktop_id:
                name = a.get("name", desktop_id)
                break
        self.pinned_apps = [a for a in self.pinned_apps if a.get("desktop_id") != desktop_id]
        self.save_pinned_apps()
        self.refresh_docks()
        spawn(f"notify-send 'Taskbar' 'Unpinned {name} from taskbar'")

    def refresh_docks(self):
        for dock in self.docks:
            dock.rebuild()

    def close_all(self, except_name=None):
        for name, popup in self.popups.items():
            if name != except_name and popup.get_visible():
                popup.close_popup()

    def show_context_menu(self, monitor, x, y):
        self.close_all(except_name="contextmenu")
        menu = self.popups.get("contextmenu")
        if not menu:
            return
        if menu.get_visible():
            menu.close_popup()
        GtkLayerShell.set_monitor(menu, monitor)
        geom = monitor.get_geometry()
        menu_w = 260
        menu_h = 420
        px = max(10, min(int(x), geom.width - menu_w - 12))
        py = max(35, min(int(y), geom.height - menu_h - 12))
        GtkLayerShell.set_margin(menu, E.LEFT, px)
        GtkLayerShell.set_margin(menu, E.TOP, py)
        menu.open_popup()

    def show_app_context_menu(self, monitor, app, x, y, is_pinned=True):
        self.close_all(except_name="appcontextmenu")
        menu = self.popups.get("appcontextmenu")
        if not menu:
            return
        if menu.get_visible():
            menu.close_popup()
        menu.populate(app, is_pinned=is_pinned)
        GtkLayerShell.set_monitor(menu, monitor)
        geom = monitor.get_geometry()
        menu_w = 250
        menu_h = 220
        px = max(10, min(int(x) - 100, geom.width - menu_w - 12))
        py = max(35, min(int(y), geom.height - menu_h - 12))
        GtkLayerShell.set_margin(menu, E.LEFT, px)
        GtkLayerShell.set_margin(menu, E.TOP, py)
        menu.open_popup()

    def show_taskbar_context_menu(self, monitor, x, y):
        self.close_all(except_name="taskbarmenu")
        menu = self.popups.get("taskbarmenu")
        if not menu:
            return
        if menu.get_visible():
            menu.close_popup()
        GtkLayerShell.set_monitor(menu, monitor)
        geom = monitor.get_geometry()
        menu_w = 240
        menu_h = 180
        px = max(10, min(int(x) - 100, geom.width - menu_w - 12))
        py = max(35, min(int(y), geom.height - menu_h - 12))
        GtkLayerShell.set_margin(menu, E.LEFT, px)
        GtkLayerShell.set_margin(menu, E.TOP, py)
        menu.open_popup()

    def toggle(self, name):
        if name == "controlcenter":
            self.close_all()
            if self.cc_proc and self.cc_proc.poll() is None:
                self.cc_proc.terminate()
            else:
                cmd = "/home/jacob/.local/bin/hypr-settings"
                self.cc_proc = subprocess.Popen([cmd],
                                                stdin=subprocess.DEVNULL, start_new_session=True)
            return
        popup = self.popups.get(name)
        if popup:
            self.close_all(except_name=name)
            popup.toggle()

    def volume(self, action):
        cmds = {
            "up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
            "down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
            "mute": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        }
        if action in cmds:
            spawn(cmds[action])

    def handle(self, argv):
        if not argv:
            return
        if argv[0] == "toggle" and len(argv) > 1:
            if argv[1] in ("contextmenu", "desktop-menu"):
                display = Gdk.Display.get_default()
                mon = display.get_monitor(0)
                geom = mon.get_geometry()
                self.show_context_menu(mon, geom.width // 2 - 140, geom.height // 2 - 200)
            else:
                self.toggle(argv[1])
        elif argv[0] == "close":
            self.close_all()
        elif argv[0] in ("reload", "refresh"):
            self.refresh_docks()
            for b in self.bars:
                b.tick_stats()
                b.tick_clock()
        elif argv[0] == "quit":
            Gtk.main_quit()
        elif argv[0] == "volume" and len(argv) > 1:
            self.volume(argv[1])

    def _start_ipc(self):
        if os.path.exists(SOCK):
            os.unlink(SOCK)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCK)
        srv.listen(8)
        srv.setblocking(False)
        self._srv = srv

        def on_accept(_fd, _cond):
            try:
                conn, _ = srv.accept()
                conn.settimeout(0.3)
                data = conn.recv(256).decode(errors="ignore").strip()
                conn.close()
            except OSError:
                return True
            self.handle(data.split())
            return True

        GLib.io_add_watch(srv.fileno(), GLib.IO_IN, on_accept)

    def _start_cpp_monitor(self):
        """Connect to high-performance C++ Hyprland event listener."""
        bin_path = os.path.expanduser("~/.local/bin/hypr-monitor")
        if not os.path.isfile(bin_path):
            return
        try:
            self._cpp_proc = subprocess.Popen(
                [bin_path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1
            )
            def on_line(_fd, _cond):
                line = self._cpp_proc.stdout.readline()
                if not line:
                    return False
                parts = line.strip().split()
                if not parts:
                    return True
                if parts[0] == "STATS" and len(parts) >= 4:
                    cpu, ram, dsk = parts[1], parts[2], parts[3]
                    for b in self.bars:
                        b.cpu_l.set_text(f"{G_CPU} {cpu}%")
                        b.ram_l.set_text(f"{G_RAM} {ram}%")
                        b.dsk_l.set_text(f"{G_DISK} {dsk}%")
                elif parts[0] == "EVENT" and len(parts) >= 2:
                    ev = parts[1]
                    if ev.startswith("workspace>>"):
                        try:
                            wid = int(ev.split(">>")[1])
                            for b in self.bars:
                                for w_id, btn in b.ws_buttons.items():
                                    ctx = btn.get_style_context()
                                    (ctx.add_class if w_id == wid else ctx.remove_class)("ws-active")
                        except Exception:
                            pass
                    elif ev.startswith("activewindow>>"):
                        for d in self.docks:
                            d.tick_running()
                return True

            GLib.io_add_watch(self._cpp_proc.stdout.fileno(), GLib.IO_IN, on_line)
        except Exception:
            pass


def main():
    if send_command(["close"], silent=True) == 0:
        print("jacob-shell is already running", file=sys.stderr)
        return 0
    Shell()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
