        self.add(card)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.pack_start(add_class(make_label(G_POWER), "glyph"), False, False, 0)
        head.pack_start(make_label("Session & Power", "title"), False, False, 0)
        card.pack_start(head, False, False, 0)
        card.pack_start(hline(), False, False, 0)
        for glyph, label, cmd in ((G_LOCK, "Lock Screen", "hyprlock"),
                                  (G_REBOOT, "Reboot System", "systemctl reboot"),
                                  (G_POWER, "Power Off", "systemctl poweroff")):
