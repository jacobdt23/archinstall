class PowerMenu(Popup):
    def __init__(self, shell):
        super().__init__(shell, "power", anchors=(E.TOP, E.RIGHT), margins={E.TOP: 36, E.RIGHT: 14},
                         keyboard=GtkLayerShell.KeyboardMode.ON_DEMAND)
