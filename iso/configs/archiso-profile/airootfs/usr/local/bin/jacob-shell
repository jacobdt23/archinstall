class ClipboardPopup(Popup):
    def __init__(self, shell):
        super().__init__(shell, "clipboard", anchors=(E.TOP, E.RIGHT), margins={E.TOP: 44, E.RIGHT: 14},
                         keyboard=GtkLayerShell.KeyboardMode.ON_DEMAND)
        card = card_box(10, 16)
        add_class(card, "card", "card-yellow")
        card.set_size_request(400, -1)
        self.add(card)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.pack_start(add_class(make_label(G_CLIP), "glyph"), False, False, 0)
        head.pack_start(make_label("Clipboard History", "title"), False, False, 0)
        head.pack_end(flat_button("Clear", "btn-open", "btn-red", cb=self._wipe), False, False, 0)
        card.pack_start(head, False, False, 0)
        self.items = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.pack_start(scrolled(self.items, height=340), True, True, 0)

    def _wipe(self):
        spawn("cliphist wipe")
        GLib.timeout_add(250, lambda: (self.on_open(), self.show_all(), False)[-1])

    def _copy(self, cid):
        self.close_popup()
        spawn(f"cliphist decode {cid} | wl-copy")

    def on_open(self):
        for c in self.items.get_children():
            self.items.remove(c)
        lines = run_out("cliphist list | head -n 25").splitlines()
        if not lines:
            self.items.pack_start(make_label("Clipboard is empty", "muted"), False, False, 0)
        for line in lines:
            cid, _, preview = line.partition("\t")
            lbl = make_label(preview.strip() or "(binary data)", ellipsize=True)
            lbl.set_max_width_chars(50)
            self.items.pack_start(flat_button(lbl, "row", cb=lambda c=cid: self._copy(c)), False, False, 0)


class MediaPopup(Popup):
    def __init__(self, shell):
        super().__init__(shell, "media", anchors=(E.TOP, E.RIGHT), margins={E.TOP: 44, E.RIGHT: 60},
                         keyboard=GtkLayerShell.KeyboardMode.ON_DEMAND)
        card = card_box(10, 16)
        add_class(card, "card", "card-blue")
        card.set_size_request(340, -1)
        self.add(card)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.pack_start(add_class(make_label(G_MEDIA), "glyph"), False, False, 0)
        head.pack_start(make_label("Media & Audio Controls", "title"), False, False, 0)
        card.pack_start(head, False, False, 0)
        self.track = make_label("No active media session", ellipsize=True)
        card.pack_start(self.track, False, False, 0)
        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, homogeneous=True)
        for glyph, cmd in ((G_PREV, "playerctl previous"), (G_PLAY, "playerctl play-pause"),
                           (G_NEXT, "playerctl next"), (G_VDN, "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),
                           (G_VUP, "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+"),
                           (G_MUTE, "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle")):
            controls.pack_start(flat_button(add_class(make_label(glyph, xalign=0.5), "glyph-media"), "row",
                                            cb=lambda c=cmd: spawn(c)), True, True, 0)
        card.pack_start(controls, False, False, 0)
        self._timer = None

    def _refresh(self):
        if not self.get_visible():
            self._timer = None
            return False
        info = run_out("playerctl metadata --format '{{artist}} - {{title}}'", timeout=1)
        self.track.set_text(info or "No active media session")
        return True

    def on_open(self):
        self._refresh()
        if self._timer is None:
            self._timer = GLib.timeout_add(2000, self._refresh)


