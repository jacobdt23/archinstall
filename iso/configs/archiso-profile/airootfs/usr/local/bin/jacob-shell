#!/usr/bin/env python3
"""
jacob-shell — Jacob's Custom Arch Linux desktop shell (Python + GTK3 + gtk-layer-shell)

Daemon  : `jacob-shell`                      starts Top Bar, Bottom Dock, notification daemon
Control : `jacob-shell toggle <panel>`       launcher | power | calendar | clipboard | keybinds
                                              notifications | media | welcome | controlcenter
          `jacob-shell volume up|down|mute`  PipeWire volume via wpctl
"""
import os
import socket
import sys

SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "jacob-shell.sock")


def send_command(argv):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1.0)
        s.connect(SOCK)
        s.sendall((" ".join(argv) + "\n").encode())
        s.close()
        return 0
    except OSError as exc:
        print(f"jacob-shell: daemon not reachable ({exc})", file=sys.stderr)
        return 1


# Client mode is handled before importing GTK so keybinds stay instant.
if len(sys.argv) > 1:
    sys.exit(send_command(sys.argv[1:]))

