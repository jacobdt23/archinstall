            row.pack_start(make_label(label, "row-title"), False, False, 0)
            card.pack_start(flat_button(row, "row", cb=lambda c=cmd: (self.close_popup(), spawn(c))), False, False, 0)


# ----------------------------------------------------------------------------
# Calendar & Notifications
# ----------------------------------------------------------------------------
class CalendarPopup(Popup):
    def __init__(self, shell):
        super().__init__(shell, "calendar", anchors=(E.TOP,), margins={E.TOP: 36},
                         keyboard=GtkLayerShell.KeyboardMode.ON_DEMAND)
        card = card_box(10, 16)
        add_class(card, "card", "card-blue")
        card.set_size_request(320, -1)
        self.add(card)
        self.date_lbl = make_label("", "title")
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.pack_start(add_class(make_label(G_CAL), "glyph"), False, False, 0)
        head.pack_start(self.date_lbl, False, False, 0)
        card.pack_start(head, False, False, 0)
        self.cal = Gtk.Calendar()
        card.pack_start(self.cal, False, False, 0)
        card.pack_start(make_label(f"{G_BELL}  Recent Notifications", "title"), False, False, 0)
        self.recent = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.pack_start(self.recent, False, False, 0)

    def on_open(self):
        self.date_lbl.set_text(time.strftime("%A, %B %d, %Y"))
        now = time.localtime()
        self.cal.select_month(now.tm_mon - 1, now.tm_year)
        self.cal.select_day(now.tm_mday)
        for c in self.recent.get_children():
            self.recent.remove(c)
        items = self.shell.history[:3]
        if not items:
            self.recent.pack_start(make_label("No recent notifications", "muted"), False, False, 0)
        for n in items:
            self.recent.pack_start(notification_row(n), False, False, 0)


def notification_row(n):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    add_class(box, "row")
    box.pack_start(make_label(n["summary"], "row-title", ellipsize=True), False, False, 0)
    if n["body"]:
        box.pack_start(make_label(n["body"], "row-desc", ellipsize=True), False, False, 0)
    return box


class NotificationCenter(Popup):
    def __init__(self, shell):
        super().__init__(shell, "notifications", anchors=(E.TOP, E.RIGHT), margins={E.TOP: 36, E.RIGHT: 14},
                         keyboard=GtkLayerShell.KeyboardMode.ON_DEMAND)
        card = card_box(10, 16)
        add_class(card, "card", "card-purple")
        card.set_size_request(380, -1)
        self.add(card)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.pack_start(add_class(make_label(G_BELL), "glyph"), False, False, 0)
        head.pack_start(make_label("Notifications Center", "title"), False, False, 0)
        head.pack_end(flat_button("Clear", "btn-open", "btn-red", cb=self._clear), False, False, 0)
        card.pack_start(head, False, False, 0)
        self.items = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.pack_start(scrolled(self.items, height=300), True, True, 0)

    def _clear(self):
        self.shell.history.clear()
        self.on_open()
        self.show_all()

    def on_open(self):
        for c in self.items.get_children():
            self.items.remove(c)
        if not self.shell.history:
            self.items.pack_start(make_label("No active notifications", "muted"), False, False, 0)
        for n in self.shell.history:
            self.items.pack_start(notification_row(n), False, False, 0)


class Toast(Layer):
    def __init__(self, shell, n, slot):
        super().__init__("toast", GtkLayerShell.Layer.OVERLAY, (E.TOP, E.RIGHT),
                         {E.TOP: 36 + slot * 78, E.RIGHT: 14})
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        add_class(box, "toast")
        box.set_size_request(340, -1)
        box.pack_start(make_label(n["summary"] or n["app"], "row-title", ellipsize=True), False, False, 0)
        if n["body"]:
            box.pack_start(make_label(n["body"], "row-desc", ellipsize=True), False, False, 0)
        self.add(box)
        self.show_all()


NOTIF_XML = """
<node>
  <interface name="org.freedesktop.Notifications">
    <method name="GetCapabilities"><arg direction="out" name="capabilities" type="as"/></method>
    <method name="Notify">
      <arg direction="in" name="app_name" type="s"/><arg direction="in" name="replaces_id" type="u"/>
      <arg direction="in" name="app_icon" type="s"/><arg direction="in" name="summary" type="s"/>
      <arg direction="in" name="body" type="s"/><arg direction="in" name="actions" type="as"/>
      <arg direction="in" name="hints" type="a{sv}"/><arg direction="in" name="expire_timeout" type="i"/>
      <arg direction="out" name="id" type="u"/>
    </method>
    <method name="CloseNotification"><arg direction="in" name="id" type="u"/></method>
    <method name="GetServerInformation">
      <arg direction="out" name="name" type="s"/><arg direction="out" name="vendor" type="s"/>
      <arg direction="out" name="version" type="s"/><arg direction="out" name="spec_version" type="s"/>
    </method>
    <signal name="NotificationClosed"><arg name="id" type="u"/><arg name="reason" type="u"/></signal>
  </interface>
</node>
"""


class NotificationDaemon:
    """org.freedesktop.Notifications server (replaces Quickshell's built-in one)."""

    def __init__(self, shell):
        self.shell = shell
        self.next_id = 1
        self.toasts = []
        self.node = Gio.DBusNodeInfo.new_for_xml(NOTIF_XML)
        Gio.bus_own_name(Gio.BusType.SESSION, "org.freedesktop.Notifications",
                         Gio.BusNameOwnerFlags.REPLACE | Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT,
                         self._bus_acquired, None, None)

    def _bus_acquired(self, connection, _name):
        connection.register_object("/org/freedesktop/Notifications", self.node.interfaces[0],
                                   self._on_call, None, None)

    def _on_call(self, _conn, _sender, _path, _iface, method, params, invocation):
        if method == "GetCapabilities":
            invocation.return_value(GLib.Variant("(as)", (["body", "actions"],)))
        elif method == "GetServerInformation":
            invocation.return_value(GLib.Variant("(ssss)", ("jacob-shell", "Jacob", "1.0", "1.2")))
        elif method == "CloseNotification":
            invocation.return_value(None)
        elif method == "Notify":
            app, replaces, _icon, summary, body, _actions, _hints, timeout = params.unpack()
            nid = replaces or self.next_id
            if not replaces:
                self.next_id += 1
            note = {"id": nid, "app": app, "summary": summary, "body": body, "time": time.time()}
            self.shell.history.insert(0, note)
            del self.shell.history[50:]
            self._toast(note, timeout)
            invocation.return_value(GLib.Variant("(u)", (nid,)))
        else:
            invocation.return_value(None)

    def _toast(self, note, timeout):
        toast = Toast(self.shell, note, len(self.toasts))
        self.toasts.append(toast)
        ms = 5000 if timeout <= 0 else min(timeout, 10000)

        def expire():
            toast.destroy()
            if toast in self.toasts:
                self.toasts.remove(toast)
            for i, t in enumerate(self.toasts):
                GtkLayerShell.set_margin(t, E.TOP, 36 + i * 78)
            return False

        GLib.timeout_add(ms, expire)


# ----------------------------------------------------------------------------
# Clipboard & Media
# ----------------------------------------------------------------------------
class ClipboardPopup(Popup):
    def __init__(self, shell):
        super().__init__(shell, "clipboard", anchors=(E.BOTTOM, E.RIGHT), margins={E.BOTTOM: 60, E.RIGHT: 14},
                         keyboard=GtkLayerShell.KeyboardMode.ON_DEMAND)
        card = card_box(10, 16)
        add_class(card, "card", "card-yellow")
        card.set_size_request(400, -1)
        self.add(card)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.pack_start(add_class(make_label(G_CLIP), "glyph"), False, False, 0)
        head.pack_start(make_label("Clipboard History", "title"), False, False, 0)
        head.pack_end(flat_button("Clear", "btn-open", "btn-red", cb=self._wipe), False, False, 0)
        card.pack_start(head, False, False, 0)
        self.items = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.pack_start(scrolled(self.items, height=340), True, True, 0)

    def _wipe(self):
        spawn("cliphist wipe")
        GLib.timeout_add(250, lambda: (self.on_open(), self.show_all(), False)[-1])

    def _copy(self, cid):
        self.close_popup()
        spawn(f"cliphist decode {cid} | wl-copy")

    def on_open(self):
        for c in self.items.get_children():
            self.items.remove(c)
        lines = run_out("cliphist list | head -n 25").splitlines()
        if not lines:
            self.items.pack_start(make_label("Clipboard is empty", "muted"), False, False, 0)
        for line in lines:
            cid, _, preview = line.partition("\t")
            lbl = make_label(preview.strip() or "(binary data)", ellipsize=True)
            lbl.set_max_width_chars(50)
            self.items.pack_start(flat_button(lbl, "row", cb=lambda c=cid: self._copy(c)), False, False, 0)


class MediaPopup(Popup):
    def __init__(self, shell):
        super().__init__(shell, "media", anchors=(E.TOP, E.RIGHT), margins={E.TOP: 36, E.RIGHT: 60},
                         keyboard=GtkLayerShell.KeyboardMode.ON_DEMAND)
        card = card_box(10, 16)
        add_class(card, "card", "card-blue")
        card.set_size_request(340, -1)
        self.add(card)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.pack_start(add_class(make_label(G_MEDIA), "glyph"), False, False, 0)
        head.pack_start(make_label("Media & Audio Controls", "title"), False, False, 0)
        card.pack_start(head, False, False, 0)
        self.track = make_label("No active media session", ellipsize=True)
        card.pack_start(self.track, False, False, 0)
        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, homogeneous=True)
        for glyph, cmd in ((G_PREV, "playerctl previous"), (G_PLAY, "playerctl play-pause"),
                           (G_NEXT, "playerctl next"), (G_VDN, "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),
                           (G_VUP, "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+"),
                           (G_MUTE, "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle")):
            controls.pack_start(flat_button(add_class(make_label(glyph, xalign=0.5), "glyph-media"), "row",
                                            cb=lambda c=cmd: spawn(c)), True, True, 0)
        card.pack_start(controls, False, False, 0)
        self._timer = None

    def _refresh(self):
        if not self.get_visible():
            self._timer = None
            return False
        info = run_out("playerctl metadata --format '{{artist}} - {{title}}'", timeout=1)
        self.track.set_text(info or "No active media session")
        return True

    def on_open(self):
        self._refresh()
        if self._timer is None:
            self._timer = GLib.timeout_add(2000, self._refresh)


