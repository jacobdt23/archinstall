# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------
def spawn(cmd):
    """Run a shell command fully detached from the shell process."""
    try:
        subprocess.Popen(
            ["sh", "-c", cmd],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


def run_out(cmd, timeout=3):
    try:
        r = subprocess.run(["sh", "-c", cmd], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           text=True, timeout=timeout)
        return r.stdout.strip()
    except Exception:
        return ""


def make_icon(path, size):
    try:
        if path and os.path.isfile(path):
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
            return Gtk.Image.new_from_pixbuf(pb)
    except GLib.Error:
        pass
    # Never fall back to the icon theme here: a broken SVG loader makes GTK abort the whole shell.
    img = Gtk.Image()
    img.set_size_request(size, size)
    return img


def make_label(text="", css=None, xalign=0.0, ellipsize=False, wrap=False):
    lbl = Gtk.Label(label=text, xalign=xalign)
    if css:
        lbl.get_style_context().add_class(css)
    if ellipsize:
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
    if wrap:
        lbl.set_line_wrap(True)
    return lbl


def add_class(widget, *names):
    ctx = widget.get_style_context()
    for n in names:
        ctx.add_class(n)
    return widget


def flat_button(child, *classes, cb=None):
    btn = Gtk.Button()
    btn.set_relief(Gtk.ReliefStyle.NONE)
    btn.set_focus_on_click(False)
    if isinstance(child, str):
        child = Gtk.Label(label=child)
    btn.add(child)
    add_class(btn, *classes)
    if cb:
        btn.connect("clicked", lambda *_: cb())
    return btn


def hline():
    return add_class(Gtk.Box(), "sep")


def scrolled(child, height=-1, width=-1):
    sw = Gtk.ScrolledWindow()
    sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    sw.set_min_content_height(height)
    if width > 0:
        sw.set_min_content_width(width)
    sw.add(child)
    return sw


def card_box(spacing=10, margin=16, *classes):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)
    return box


E = GtkLayerShell.Edge


class Layer(Gtk.Window):
    """A wlr-layer-shell surface with transparent background."""

    def __init__(self, name, layer=GtkLayerShell.Layer.TOP, anchors=(), margins=None,
                 keyboard=GtkLayerShell.KeyboardMode.NONE, exclusive=False, monitor=None):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title(f"jacob-{name}")
        self.set_decorated(False)
        self.set_app_paintable(True)
        self.set_resizable(False)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, f"jacob-{name}")
        GtkLayerShell.set_layer(self, layer)
        for edge in (E.TOP, E.BOTTOM, E.LEFT, E.RIGHT):
            GtkLayerShell.set_anchor(self, edge, edge in anchors)
        for edge, px in (margins or {}).items():
            GtkLayerShell.set_margin(self, edge, px)
        GtkLayerShell.set_keyboard_mode(self, keyboard)
        if exclusive:
            GtkLayerShell.auto_exclusive_zone_enable(self)
        if monitor is not None:
            GtkLayerShell.set_monitor(self, monitor)
        add_class(self, "transparent")


class Popup(Layer):
    """Toggleable overlay panel. Escape closes it."""

    def __init__(self, shell, name, **kw):
        kw.setdefault("layer", GtkLayerShell.Layer.OVERLAY)
        super().__init__(name, **kw)
        self.shell = shell
        self.connect("key-press-event", self._on_key)

    def _on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.close_popup()
            return True
        return self.handle_key(ev)

    def handle_key(self, _ev):
        return False

    def on_open(self):
        pass

    def open_popup(self):
        self.on_open()
        self.show_all()
        self.present()

    def close_popup(self):
        self.hide()

    def toggle(self):
        if self.get_visible():
            self.close_popup()
        else:
            self.open_popup()


# ----------------------------------------------------------------------------
# Top Bar (Full Length Floating Glass Bar)
# ----------------------------------------------------------------------------
class TopBar(Layer):
    def __init__(self, shell, monitor, index):
        super().__init__("topbar", GtkLayerShell.Layer.TOP, (E.TOP, E.LEFT, E.RIGHT),
                         margins={E.TOP: 6, E.LEFT: 12, E.RIGHT: 12},
                         exclusive=True, monitor=monitor)
        self.shell = shell
        self.monitor = monitor
        self.mon_index = index
        self.ws_ids = [1, 2, 3, 4, 5] if index == 0 else [6, 7, 8, 9, 10]
        self.ws_buttons = {}
        self._last_cpu = None

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, homogeneous=True)
        add_class(root, "bar-full")
        root.set_size_request(-1, 34)
        self.add(root)

        # ----------------- Left: Branding + Workspaces + Window Title -----------------
        left = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        left.set_halign(Gtk.Align.START)

        # Branding chip
        brand = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        brand.pack_start(make_icon(LOGO, 18), False, False, 0)
        brand.pack_start(make_label("JacobOS", "brand-label"), False, False, 0)
        brand_btn = flat_button(brand, "brand-chip", cb=lambda: shell.toggle("welcome"))
        brand_btn.set_tooltip_text("JacobOS Hub (Super + W)")
        left.pack_start(brand_btn, False, False, 0)

        left.pack_start(add_class(Gtk.Box(), "sep-v"), False, False, 2)

        # Workspaces
        ws_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=3)
        for wid in self.ws_ids:
            b = flat_button(str(wid), "ws", cb=lambda w=wid: spawn(f"hyprctl dispatch workspace {w}"))
            self.ws_buttons[wid] = b
            ws_box.pack_start(b, False, False, 0)
        left.pack_start(ws_box, False, False, 0)

        left.pack_start(add_class(Gtk.Box(), "sep-v"), False, False, 2)

        # Active Window Title
        self.win_title_pill = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        add_class(self.win_title_pill, "win-pill")
        self.win_title_label = Gtk.Label()
        self.win_title_label.set_ellipsize(Pango.EllipsizeMode.END)
        self.win_title_label.set_max_width_chars(35)
        self.win_title_pill.pack_start(self.win_title_label, False, False, 0)
        self.win_title_pill.set_no_show_all(True)
        left.pack_start(self.win_title_pill, False, False, 2)

        root.pack_start(left, True, True, 0)

        # ----------------- Center: Live Clock & Media Chip -----------------
        center = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        center.set_halign(Gtk.Align.CENTER)
        self.clock = Gtk.Label()
        clock_btn = flat_button(self.clock, "pill", "clock-pill", cb=lambda: shell.toggle("calendar"))
        center.pack_start(clock_btn, False, False, 0)

        media_chip = flat_button(f"{G_MEDIA}  Media", "pill", cb=lambda: shell.toggle("media"))
        media_chip.set_tooltip_text("Audio & Media Player (Super + M)")
        center.pack_start(media_chip, False, False, 0)

        root.pack_start(center, True, True, 0)

        # ----------------- Right: Stats + Tray + Power -----------------
        right = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        right.set_halign(Gtk.Align.END)

        self.cpu_l, self.ram_l, self.dsk_l, self.vol_l = (Gtk.Label() for _ in range(4))
        for lbl in (self.cpu_l, self.ram_l, self.dsk_l):
            pill = add_class(Gtk.Box(), "pill")
            pill.add(lbl)
            right.pack_start(pill, False, False, 0)

        right.pack_start(flat_button(self.vol_l, "pill", cb=lambda: shell.toggle("media")), False, False, 0)
        right.pack_start(flat_button(G_BELL, "pill", cb=lambda: shell.toggle("notifications")), False, False, 0)
        right.pack_start(flat_button("󰒓", "pill", cb=lambda: shell.toggle("controlcenter")), False, False, 0)
        right.pack_start(flat_button(G_POWER, "pill", "btn-red", cb=lambda: shell.toggle("power")), False, False, 0)
        root.pack_start(right, True, True, 0)

        # Right-click on top bar opens desktop context menu
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self._on_bar_click)

        self.tick_clock()
        GLib.timeout_add_seconds(1, self.tick_clock)
        self.tick_stats()
        GLib.timeout_add(2500, self.tick_stats)
        self.tick_workspace()
        GLib.timeout_add(800, self.tick_workspace)

    def _on_bar_click(self, _w, ev):
        if ev.button == 3:
            self.shell.show_context_menu(self.monitor, ev.x, 48)
            return True
        return False

    def tick_clock(self):
        self.clock.set_text(f"{G_CAL}  {time.strftime('%a, %b %d • %I:%M %p')}")
        return True

    @staticmethod
    def _read_cpu():
        with open("/proc/stat") as f:
            parts = f.readline().split()[1:]
        vals = list(map(int, parts))
        idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
        return sum(vals), idle

    def tick_stats(self):
        try:
            total, idle = self._read_cpu()
            if self._last_cpu:
                dt, di = total - self._last_cpu[0], idle - self._last_cpu[1]
                cpu = int(100 * (dt - di) / dt) if dt > 0 else 0
            else:
                cpu = 0
            self._last_cpu = (total, idle)
            mem = {}
            with open("/proc/meminfo") as f:
                for line in f:
                    k, v = line.split(":", 1)
                    mem[k] = int(v.split()[0])
            ram = int(100 * (mem["MemTotal"] - mem["MemAvailable"]) / mem["MemTotal"])
            du = shutil.disk_usage("/")
            dsk = int(100 * du.used / du.total)
            self.cpu_l.set_text(f"{G_CPU} {cpu}%")
            self.ram_l.set_text(f"{G_RAM} {ram}%")
            self.dsk_l.set_text(f"{G_DISK} {dsk}%")
        except Exception:
            pass
        vol = run_out("wpctl get-volume @DEFAULT_AUDIO_SINK@", timeout=1)
        try:
            level = int(float(vol.split()[1]) * 100)
            self.vol_l.set_text(f"{G_MUTE if '[MUTED]' in vol else G_VOL} {level}%")
        except (IndexError, ValueError):
            self.vol_l.set_text(f"{G_VOL} --")
        return True

    def tick_workspace(self):
        if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            return True
        try:
            r = subprocess.run(["hyprctl", "-j", "activeworkspace"], stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, text=True, timeout=1)
            active = json.loads(r.stdout).get("id")
        except Exception:
            return True
        for wid, btn in self.ws_buttons.items():
            ctx = btn.get_style_context()
            (ctx.add_class if wid == active else ctx.remove_class)("ws-active")

        try:
            rw = subprocess.run(["hyprctl", "-j", "activewindow"], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True, timeout=1)
            wdata = json.loads(rw.stdout)
            title = wdata.get("title") or wdata.get("class") or ""
            if title:
                self.win_title_label.set_text(title)
                self.win_title_pill.show_all()
            else:
                self.win_title_pill.hide()
        except Exception:
            pass
        return True


# ----------------------------------------------------------------------------
# Bottom Dock (Full Length Floating Glass Taskbar)
# ----------------------------------------------------------------------------
class BottomDock(Layer):
    def __init__(self, shell, monitor):
        super().__init__("dock", GtkLayerShell.Layer.TOP, (E.BOTTOM, E.LEFT, E.RIGHT),
                         margins={E.BOTTOM: 6, E.LEFT: 12, E.RIGHT: 12},
                         exclusive=True, monitor=monitor)
        self.shell = shell
        self.monitor = monitor
        self.dock_buttons = []

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, homogeneous=True)
        add_class(root, "dock-full")
        root.set_size_request(-1, 46)
        self.add(root)

        # ----------------- Left: Start Button + Search -----------------
        left = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        left.set_halign(Gtk.Align.START)

        # Start Button
        start_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        start_box.pack_start(make_icon(LOGO, 22), False, False, 0)
        start_lbl = Gtk.Label(label="Start")
        add_class(start_lbl, "start-label")
        start_box.pack_start(start_lbl, False, False, 0)
        start_btn = flat_button(start_box, "dock-start", cb=lambda: self.shell.toggle("launcher"))
        start_btn.set_tooltip_text("Start / App Drawer (Super)")
        left.pack_start(start_btn, False, False, 0)

        # Search Pill Trigger
        search_btn = flat_button("󰍏  Search apps...", "search-pill", cb=lambda: self.shell.toggle("launcher"))
        search_btn.set_tooltip_text("Search applications (Super)")
        left.pack_start(search_btn, False, False, 0)

        root.pack_start(left, True, True, 0)

        # ----------------- Center: Main Pinned & Running Apps -----------------
        center = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        center.set_halign(Gtk.Align.CENTER)
        self.dock_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        self.dock_box.set_halign(Gtk.Align.CENTER)
        center.pack_start(self.dock_box, True, True, 0)
        root.pack_start(center, True, True, 0)

        # ----------------- Right: Utilities (Clipboard, Snip, Keys, Welcome) + Show Desktop -----------------
        right = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        right.set_halign(Gtk.Align.END)

        clip_btn = flat_button(f"{G_CLIP}  Clipboard", "pill", cb=lambda: self.shell.toggle("clipboard"))
        clip_btn.set_tooltip_text("Clipboard History (Super + Shift + V)")
        right.pack_start(clip_btn, False, False, 0)

        snip_btn = flat_button("󰄀  Snip", "pill", cb=lambda: spawn("/home/jacob/.local/bin/hypr-screenshot area"))
        snip_btn.set_tooltip_text("Take Screenshot / Snip (Print / Super + Shift + S)")
        right.pack_start(snip_btn, False, False, 0)

        keys_btn = flat_button(f"{G_KEY}  Keys", "pill", cb=lambda: self.shell.toggle("keybinds"))
        keys_btn.set_tooltip_text("Keyboard Shortcuts (Super + K)")
        right.pack_start(keys_btn, False, False, 0)

        # Show desktop bar at far right
        show_dt = flat_button("", "show-desktop-btn", cb=lambda: spawn("hyprctl dispatch workspace special:magic"))
        show_dt.set_tooltip_text("Show Desktop / Scratchpad (Super + S)")
        right.pack_start(show_dt, False, False, 0)

        root.pack_start(right, True, True, 0)

        self.rebuild()

        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self._on_dock_click)

        GLib.timeout_add(1000, self.tick_running)

    def _on_dock_click(self, _w, ev):
        if ev.button == 3:
            geom = self.monitor.get_geometry()
            self.shell.show_taskbar_context_menu(self.monitor, ev.x, max(35, geom.height - 230))
            return True
        return False

    def rebuild(self):
        for c in self.dock_box.get_children():
            self.dock_box.remove(c)
        self.dock_buttons.clear()

        # Dynamic Pinned Apps
        for app in self.shell.pinned_apps:
            icon_path = app.get("icon", LOGO)
            cmd = app.get("cmd") or f"gtk-launch '{app.get('desktop_id')}'"
            name = app.get("name", app.get("desktop_id", "App"))
            desktop_id = app.get("desktop_id", "").lower()

            btn = Gtk.Button()
            btn.set_relief(Gtk.ReliefStyle.NONE)
            btn.set_focus_on_click(False)
            add_class(btn, "dock-app-btn")
            btn.set_tooltip_text(name)

            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            col.pack_start(make_icon(icon_path, 24), False, False, 0)
            indicator = Gtk.Box()
            add_class(indicator, "app-indicator")
            col.pack_start(indicator, False, False, 0)
            btn.add(col)

            self.dock_buttons.append((desktop_id, indicator))

            def make_press_cb(a=app, c=cmd):
                def _press(_w, ev):
                    if ev.button == 3:  # Right-click app context menu!
                        geom = self.monitor.get_geometry()
                        menu_x = min(max(10, int(ev.x)), geom.width - 260)
                        self.shell.show_app_context_menu(self.monitor, a, menu_x, geom.height - 260, is_pinned=True)
                        return True
                    elif ev.button == 1:  # Left-click launch
                        spawn(c)
                        return True
                    return False
                return _press

            btn.connect("button-press-event", make_press_cb())
            self.dock_box.pack_start(btn, False, False, 0)

        # Calamares installer (if running in live environment)
        if os.path.isfile(CALAMARES_BIN):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            row.pack_start(make_icon(f"{HICOLOR}/scalable/apps/calamares.svg", 18), False, False, 0)
            row.pack_start(Gtk.Label(label="Install Arch"), False, False, 0)
            self.dock_box.pack_start(flat_button(row, "dock-install", cb=lambda: spawn(CALAMARES_BIN)), False, False, 0)

        self.dock_box.show_all()

    def tick_running(self):
        if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            return True
        try:
            rc = subprocess.run(["hyprctl", "-j", "clients"], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True, timeout=1)
            clients = json.loads(rc.stdout)
            running_classes = {c.get("class", "").lower() for c in clients}
            running_initial = {c.get("initialClass", "").lower() for c in clients}
            all_running = running_classes.union(running_initial)
            for did, ind in self.dock_buttons:
                is_running = any(did in r or r in did for r in all_running if r)
                ctx = ind.get_style_context()
                if is_running:
                    ctx.add_class("app-indicator-running")
                else:
                    ctx.remove_class("app-indicator-running")
        except Exception:
            pass
        return True

# ----------------------------------------------------------------------------
# Application Launcher
# ----------------------------------------------------------------------------
class Launcher(Popup):
    def __init__(self, shell):
        super().__init__(shell, "launcher", anchors=(E.BOTTOM, E.LEFT), margins={E.BOTTOM: 60, E.LEFT: 14}, keyboard=GtkLayerShell.KeyboardMode.EXCLUSIVE)
        card = card_box(10, 16)
        add_class(card, "card", "card-blue")
        card.set_size_request(540, 480)
        self.add(card)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.pack_start(make_icon(LOGO, 20), False, False, 0)
        head.pack_start(make_label("Application Launcher", "title"), False, False, 0)
        head.pack_end(make_label("ESC to close", "muted"), False, False, 0)
        card.pack_start(head, False, False, 0)

        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text("Search applications...")
        self.entry.connect("changed", self._on_changed)
        self.entry.connect("activate", lambda *_: self._launch_selected())
        card.pack_start(self.entry, False, False, 0)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.set_filter_func(self._filter)
        self.listbox.connect("row-activated", lambda _lb, row: self._launch(row))
        card.pack_start(scrolled(self.listbox), True, True, 0)
        self.rows = []

    def _populate(self):
        for r in self.rows:
            self.listbox.remove(r)
        self.rows = []
        cmd = os.path.expanduser("~/.local/bin/list-desktop-apps")
        if not os.path.isfile(cmd):
            cmd = "/usr/local/bin/list-desktop-apps"
        for line in run_out(cmd, timeout=6).splitlines():
            parts = line.split("\t")
            if len(parts) < 4:
                continue
            name, desc, desktop_id, icon_path = parts[:4]
            app_dict = {
                "name": name,
                "desc": desc,
                "desktop_id": desktop_id,
                "icon": icon_path,
                "cmd": f"gtk-launch '{desktop_id}' || gio launch '/usr/share/applications/{desktop_id}.desktop'",
            }
            row = Gtk.ListBoxRow()
            row.app = (name, desc, desktop_id, icon_path)
            row.app_dict = app_dict
            body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            add_class(body, "row")
            body.pack_start(make_icon(icon_path, 32), False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            text.pack_start(make_label(name, "row-title", ellipsize=True), False, False, 0)
            text.pack_start(make_label(desc, "row-desc", ellipsize=True), False, False, 0)
            body.pack_start(text, True, True, 0)

            is_pinned = any(a.get("desktop_id") == desktop_id for a in self.shell.pinned_apps)
            if is_pinned:
                pin_icon = make_label("\U000F0403", "menu-icon")
                pin_icon.set_tooltip_text("Pinned to taskbar")
                body.pack_end(pin_icon, False, False, 0)
            else:
                body.pack_end(make_label("\U000F0054", "muted"), False, False, 0)
            row.add(body)

            row.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            def make_row_press(ad=app_dict):
                def _on_row_click(_w, ev):
                    if ev.button == 3:  # Right-click row
                        display = Gdk.Display.get_default()
                        mon = display.get_monitor(0)
                        pinned = any(p.get("desktop_id") == ad["desktop_id"] for p in self.shell.pinned_apps)
                        geom = mon.get_geometry()
                        win_alloc = self.get_allocation()
                        alloc = _w.get_allocation()
                        pos_x = (geom.width - win_alloc.width) // 2 + 150
                        pos_y = (geom.height - win_alloc.height) // 2 + alloc.y
                        self.shell.show_app_context_menu(mon, ad, pos_x, pos_y, is_pinned=pinned)
                        return True
                    return False
                return _on_row_click

            row.connect("button-press-event", make_row_press())
            self.listbox.add(row)
            self.rows.append(row)

    def _visible_rows(self):
        return [r for r in self.rows if r.get_child_visible() and self._filter(r)]

    def _filter(self, row):
        q = self.entry.get_text().strip().lower()
        if not q or not hasattr(row, "app"):
            return True
        name, desc, did = row.app[:3]
        return q in name.lower() or q in desc.lower() or q in did.lower()

    def _on_changed(self, *_):
        self.listbox.invalidate_filter()
        vis = self._visible_rows()
        if vis:
            self.listbox.select_row(vis[0])

    def _launch(self, row):
        if row is None or not hasattr(row, "app"):
            return
        did = row.app[2]
        self.close_popup()
        spawn(f"gtk-launch '{did}' || gio launch '/usr/share/applications/{did}.desktop'")

    def _launch_selected(self):
        row = self.listbox.get_selected_row()
        vis = self._visible_rows()
        self._launch(row if row in vis else (vis[0] if vis else None))

    def handle_key(self, ev):
        if ev.keyval in (Gdk.KEY_Down, Gdk.KEY_Up):
            vis = self._visible_rows()
            if not vis:
                return True
            cur = self.listbox.get_selected_row()
            idx = vis.index(cur) if cur in vis else -1
            idx = min(idx + 1, len(vis) - 1) if ev.keyval == Gdk.KEY_Down else max(idx - 1, 0)
            self.listbox.select_row(vis[idx])
            vis[idx].grab_focus()
            self.entry.grab_focus()
            return True
        return False

    def on_open(self):
        self.entry.set_text("")
        self._populate()
        vis = self._visible_rows()
        if vis:
            self.listbox.select_row(vis[0])

    def open_popup(self):
        super().open_popup()
        self.entry.grab_focus()


