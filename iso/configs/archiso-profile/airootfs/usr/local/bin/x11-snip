#!/usr/bin/env python3
"""
HyprFrost Native X11 Screenshot & Snipping Engine
Supports interactive drag-to-snip, active window, and fullscreen capture on X11.
Tokyo Night aesthetics matching HyprFrost styling.
"""

import argparse
import glob
import os
import subprocess
import sys
import warnings
warnings.filterwarnings("ignore")

# Ensure DISPLAY and XAUTHORITY are properly configured
if not os.environ.get("DISPLAY"):
    os.environ["DISPLAY"] = ":0"

if "XAUTHORITY" not in os.environ:
    auth_candidates = glob.glob(f"/tmp/xauth_*") + [os.path.expanduser("~/.Xauthority")]
    for candidate in auth_candidates:
        if os.path.isfile(candidate) and os.access(candidate, os.R_OK):
            os.environ["XAUTHORITY"] = candidate
            break

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, cairo


def get_screen_pixbuf():
    display = Gdk.Display.get_default()
    if not display:
        sys.stderr.write("Error: Could not open GDK display.\n")
        sys.exit(1)
    screen = display.get_default_screen()
    root = screen.get_root_window()
    sw = screen.get_width()
    sh = screen.get_height()
    pix = Gdk.pixbuf_get_from_window(root, 0, 0, sw, sh)
    if not pix:
        sys.stderr.write("Error: Failed to grab root window.\n")
        sys.exit(1)
    return pix, sw, sh


def get_active_window_geo():
    # 1. Try Qtile IPC first
    try:
        from libqtile.command.client import InteractiveCommandClient
        client = InteractiveCommandClient()
        win = client.window.info()
        if win and win.get("width", 0) > 0 and win.get("height", 0) > 0:
            return win["x"], win["y"], win["width"], win["height"]
    except Exception:
        pass

    # 2. Try xdotool if available
    try:
        out = subprocess.check_output(["xdotool", "getactivewindow", "getwindowgeometry"], text=True)
        # Parse position and geometry
        x = y = w = h = None
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("Position:"):
                parts = line.split()[1].split(",")
                x, y = int(parts[0]), int(parts[1])
            elif line.startswith("Geometry:"):
                parts = line.split()[1].split("x")
                w, h = int(parts[0]), int(parts[1])
        if None not in (x, y, w, h) and w > 0 and h > 0:
            return x, y, w, h
    except Exception:
        pass

    return None


def copy_pixbuf_to_clipboard(pix):
    try:
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_image(pix)
        clipboard.store()
    except Exception:
        pass

    # Also invoke xclip for background durability
    xclip_bin = "/home/jacob/.local/bin/xclip"
    if not os.path.isfile(xclip_bin):
        xclip_bin = "xclip"
    try:
        ok, buf = pix.save_to_bufferv("png", [], [])
        if ok:
            p = subprocess.Popen([xclip_bin, "-selection", "clipboard", "-t", "image/png"], stdin=subprocess.PIPE)
            p.communicate(input=buf)
    except Exception:
        pass


def notify_saved(target_file, mode_name):
    try:
        base = os.path.basename(target_file)
        subprocess.Popen([
            "notify-send",
            "-a", "Screenshot",
            "-i", target_file,
            f"Screenshot Captured ({mode_name})",
            f"Saved to {base}\nCopied to clipboard."
        ])
    except Exception:
        pass


class SnipAreaOverlay(Gtk.Window):
    def __init__(self, full_pix, sw, sh, on_selected):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.pixbuf = full_pix
        self.sw = sw
        self.sh = sh
        self.on_selected = on_selected

        self.set_app_paintable(True)
        visual = self.get_screen().get_rgba_visual() or self.get_screen().get_system_visual()
        self.set_visual(visual)

        self.set_default_size(self.sw, self.sh)
        self.move(0, 0)
        self.set_keep_above(True)

        self.start_x = None
        self.start_y = None
        self.cur_x = None
        self.cur_y = None
        self.is_dragging = False

        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.KEY_PRESS_MASK
        )

        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_button_press)
        self.connect("button-release-event", self.on_button_release)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("key-press-event", self.on_key_press)

    def on_draw(self, widget, cr):
        # Draw base captured screen
        Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
        cr.paint()

        # Draw dark dim overlay (Tokyo Night glass)
        cr.set_source_rgba(0.08, 0.09, 0.13, 0.60)
        cr.paint()

        if self.is_dragging and self.start_x is not None and self.cur_x is not None:
            rx = int(min(self.start_x, self.cur_x))
            ry = int(min(self.start_y, self.cur_y))
            rw = int(abs(self.cur_x - self.start_x))
            rh = int(abs(self.cur_y - self.start_y))

            if rw > 0 and rh > 0:
                # Reveal selected region in full brightness
                cr.save()
                cr.rectangle(rx, ry, rw, rh)
                cr.clip()
                Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
                cr.paint()
                cr.restore()

                # Tokyo Night blue accent border (#7aa2f7)
                cr.set_source_rgba(0.48, 0.64, 0.97, 1.0)
                cr.set_line_width(2.0)
                cr.rectangle(rx + 0.5, ry + 0.5, rw - 1.0, rh - 1.0)
                cr.stroke()

                # Dimension Badge
                label = f"{rw} × {rh}"
                cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                cr.set_font_size(11)
                ext = cr.text_extents(label)
                bx = rx + 8
                by = ry + rh + 22
                if by > self.sh - 12:
                    by = ry - 10
                if by < 24:
                    by = ry + 24

                # Badge pill background
                cr.set_source_rgba(0.10, 0.11, 0.15, 0.94)
                cr.rectangle(bx - 6, by - ext.height - 4, ext.width + 12, ext.height + 8)
                cr.fill()
                cr.set_source_rgba(0.48, 0.64, 0.97, 0.8)
                cr.set_line_width(1.0)
                cr.rectangle(bx - 6, by - ext.height - 4, ext.width + 12, ext.height + 8)
                cr.stroke()

                # Badge text
                cr.set_source_rgba(0.75, 0.79, 0.96, 1.0)
                cr.move_to(bx, by)
                cr.show_text(label)

        return True

    def on_button_press(self, widget, event):
        if event.button == 1:
            self.start_x = event.x
            self.start_y = event.y
            self.cur_x = event.x
            self.cur_y = event.y
            self.is_dragging = True
            self.queue_draw()
        elif event.button == 3:  # Right click to cancel
            self.hide()
            Gtk.main_quit()
            sys.exit(0)

    def on_motion(self, widget, event):
        if self.is_dragging:
            self.cur_x = event.x
            self.cur_y = event.y
            self.queue_draw()

    def on_button_release(self, widget, event):
        if event.button == 1 and self.is_dragging:
            self.is_dragging = False
            rx = int(min(self.start_x, self.cur_x))
            ry = int(min(self.start_y, self.cur_y))
            rw = int(abs(self.cur_x - self.start_x))
            rh = int(abs(self.cur_y - self.start_y))

            self.hide()
            Gtk.main_quit()

            if rw > 4 and rh > 4:
                rx = max(0, min(rx, self.sw - 1))
                ry = max(0, min(ry, self.sh - 1))
                rw = min(rw, self.sw - rx)
                rh = min(rh, self.sh - ry)

                cropped = self.pixbuf.new_subpixbuf(rx, ry, rw, rh)
                self.on_selected(cropped, f"{rx},{ry} {rw}x{rh}")
            else:
                sys.exit(0)

    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            self.hide()
            Gtk.main_quit()
            sys.exit(0)


def output_result(pix, target_file, to_stdout, copy_clip, notify, mode_name):
    if to_stdout:
        ok, buf = pix.save_to_bufferv("png", [], [])
        if ok:
            sys.stdout.buffer.write(buf)
            sys.stdout.buffer.flush()
    elif target_file:
        os.makedirs(os.path.dirname(os.path.abspath(target_file)), exist_ok=True)
        pix.savev(target_file, "png", [], [])
        if copy_clip:
            copy_pixbuf_to_clipboard(pix)
        if notify:
            notify_saved(target_file, mode_name)


def main():
    parser = argparse.ArgumentParser(description="HyprFrost X11 Screenshot Utility")
    parser.add_argument("mode", choices=["area", "full", "window", "snip"], nargs="?", default="area")
    parser.add_argument("-o", "--output", dest="output", help="Output file path")
    parser.add_argument("--stdout", action="store_true", help="Output PNG to stdout")
    parser.add_argument("--copy", action="store_true", help="Copy to clipboard")
    parser.add_argument("--notify", action="store_true", help="Send notification")
    args = parser.parse_args()

    full_pix, sw, sh = get_screen_pixbuf()

    if args.mode == "full":
        output_result(full_pix, args.output, args.stdout, args.copy, args.notify, "Full Screen")
        sys.exit(0)

    elif args.mode == "window":
        geo = get_active_window_geo()
        if geo:
            wx, wy, ww, wh = geo
            wx = max(0, min(wx, sw - 1))
            wy = max(0, min(wy, sh - 1))
            ww = min(ww, sw - wx)
            wh = min(wh, sh - wy)
            win_pix = full_pix.new_subpixbuf(wx, wy, ww, wh)
            output_result(win_pix, args.output, args.stdout, args.copy, args.notify, "Active Window")
            sys.exit(0)
        else:
            # Fallback to area snip if active window cannot be resolved
            pass

    # Mode: area or snip
    def handle_selected(cropped_pix, geo_str):
        output_result(cropped_pix, args.output, args.stdout, args.copy, args.notify, "Selected Area")
        sys.exit(0)

    overlay = SnipAreaOverlay(full_pix, sw, sh, handle_selected)
    overlay.show_all()

    # Grab pointer and keyboard
    seat = Gdk.Display.get_default().get_default_seat()
    cursor = Gdk.Cursor.new_from_name(Gdk.Display.get_default(), "crosshair")
    seat.grab(overlay.get_window(), Gdk.SeatCapabilities.ALL, True, cursor, None, None)

    Gtk.main()


if __name__ == "__main__":
    main()
