#!/usr/bin/env python3
"""
HyprFrost Welcome Center
Standalone, lightweight GTK3 First-Boot Hub & Keybinds Cheat Sheet.
Compatible with both Qtile (X11 / Wayland) and Hyprland.
"""

import os
import sys
import subprocess
import signal

# ---------------------------------------------------------
# Single-instance / Toggle logic
# ---------------------------------------------------------
PID_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/tmp"), "hyprfrost-welcome.pid")

def check_toggle():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, signal.SIGTERM)
            os.remove(PID_FILE)
            sys.exit(0)
        except Exception:
            pass
    try:
        with open(PID_FILE, "w") as f:
            f.write(str(os.getpid()))
    except Exception:
        pass

check_toggle()

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, Pango, GLib

DISABLED_FLAG = os.path.expanduser("~/.config/hyprfrost-welcome-disabled")
LOGO_ARCH = "/usr/share/icons/Papirus-Dark/48x48/apps/distributor-logo-archlinux.svg"
if not os.path.isfile(LOGO_ARCH):
    LOGO_ARCH = "/usr/share/pixmaps/archlinux-logo.png"

# Tokyo Night Theme CSS
CSS_DATA = b"""
