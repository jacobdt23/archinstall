    font-family: 'JetBrainsMono Nerd Font', 'Noto Sans', sans-serif;
    color: #c0caf5;
}

window {
    background-color: #1a1b26;
    border: 2px solid #7aa2f7;
    border-radius: 14px;
}

.welcome-header {
    background: linear-gradient(135deg, #1f2335 0%, #24283b 100%);
