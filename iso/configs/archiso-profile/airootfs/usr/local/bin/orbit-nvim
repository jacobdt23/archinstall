#!/usr/bin/env bash
export NVIM_APPNAME="nvim-hyprland"
if [[ "${1:-}" == "--hyprland" ]]; then
    shift
    exec kitty --class dev.orbit.Edit --title "Orbit Neovim (LazyVim)" -e nvim "${HOME}/.config/hypr-standalone/hyprland.conf" "$@"
fi
exec kitty --class dev.orbit.Edit --title "Orbit Neovim (LazyVim)" -e nvim "$@"
