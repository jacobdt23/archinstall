#!/usr/bin/env bash
export NVIM_APPNAME="nvim-hyprland"
if [[ "${1:-}" == "--hyprland" ]]; then
    shift
    exec /usr/local/bin/orbit-term --title "Orbit Neovim (LazyVim)" -e nvim "${HOME}/.config/hypr-standalone/hyprland.conf" "$@"
fi
exec /usr/local/bin/orbit-term --title "Orbit Neovim (LazyVim)" -e nvim "$@"
