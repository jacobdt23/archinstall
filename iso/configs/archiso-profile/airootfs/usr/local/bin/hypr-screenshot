        # BIG CAPTURE BUTTON
        self.btn_capture = Gtk.Button()
        self.btn_capture.get_style_context().add_class("primary-btn")
        lbl_cap = Gtk.Label(label="󰄀  Take Screenshot")
        self.btn_capture.add(lbl_cap)
        self.btn_capture.connect("clicked", self.on_capture_clicked)
        left_box.pack_end(self.btn_capture, False, False, 0)

        # RIGHT PANE: Preview & Recent Captures
        right_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        main_box.pack_start(right_box, True, True, 0)

        # Top Preview Box
