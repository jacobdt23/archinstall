class ScreenshotApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="HyprFrost Screenshot")
        self.set_name("screenshot-window")
        self.get_style_context().add_class("screenshot-window")
        self.set_default_size(780, 520)
        self.set_position(Gtk.WindowPosition.CENTER)

        self.current_mode = "area"  # area, window, full
        self.selected_file = None
        self.history_files = []

        self.setup_header()
        self.setup_ui()
        self.refresh_history()

    def setup_header(self):
        hb = Gtk.HeaderBar()
        hb.set_show_close_button(True)
        hb.props.title = "󰄀 HyprFrost Screenshot"
        hb.props.subtitle = "Cross-platform capture suite"
        self.set_titlebar(hb)

        # Open screenshots folder button
        btn_folder = Gtk.Button()
        btn_folder.set_tooltip_text("Open Screenshots Folder")
        btn_folder.get_style_context().add_class("action-btn")
        lbl = Gtk.Label(label="󰉋 Folder")
        btn_folder.add(lbl)
        btn_folder.connect("clicked", lambda w: open_folder())
        hb.pack_start(btn_folder)

        # Refresh history
        btn_refresh = Gtk.Button()
        btn_refresh.set_tooltip_text("Refresh Captures")
        btn_refresh.get_style_context().add_class("action-btn")
        lbl_r = Gtk.Label(label="󰑐")
        btn_refresh.add(lbl_r)
        btn_refresh.connect("clicked", lambda w: self.refresh_history())
        hb.pack_end(btn_refresh)

    def setup_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        main_box.set_margin_top(14)
        main_box.set_margin_bottom(14)
        main_box.set_margin_start(14)
        main_box.set_margin_end(14)
        self.add(main_box)

        # LEFT PANE: Controls & Capture Options (Width ~280)
        left_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        left_box.set_size_request(280, -1)
        main_box.pack_start(left_box, False, False, 0)

        # Section: Mode Selection
        lbl_mode = Gtk.Label(label="<b>CAPTURE MODE</b>", use_markup=True, xalign=0)
        lbl_mode.get_style_context().add_class("dim-label")
        left_box.pack_start(lbl_mode, False, False, 0)

        mode_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        left_box.pack_start(mode_box, False, False, 0)

        self.btn_area = Gtk.RadioButton.new_with_label(None, "󰄀  Select Area")
        self.btn_area.set_mode(False)
        self.btn_area.get_style_context().add_class("mode-btn")
        self.btn_area.set_active(True)
        self.btn_area.connect("toggled", lambda w: self.set_mode("area") if w.get_active() else None)
        mode_box.pack_start(self.btn_area, False, False, 0)

        self.btn_window = Gtk.RadioButton.new_with_label_from_widget(self.btn_area, "󰖲  Active Window")
        self.btn_window.set_mode(False)
        self.btn_window.get_style_context().add_class("mode-btn")
        self.btn_window.connect("toggled", lambda w: self.set_mode("window") if w.get_active() else None)
        mode_box.pack_start(self.btn_window, False, False, 0)

        self.btn_full = Gtk.RadioButton.new_with_label_from_widget(self.btn_area, "󰍹  Entire Screen")
        self.btn_full.set_mode(False)
        self.btn_full.get_style_context().add_class("mode-btn")
        self.btn_full.connect("toggled", lambda w: self.set_mode("full") if w.get_active() else None)
        mode_box.pack_start(self.btn_full, False, False, 0)

        # Section: Delay Option
        lbl_delay = Gtk.Label(label="<b>DELAY TIMER</b>", use_markup=True, xalign=0)
        lbl_delay.set_margin_top(4)
        left_box.pack_start(lbl_delay, False, False, 0)

        self.delay_combo = Gtk.ComboBoxText()
        self.delay_combo.append("0", "⚡ Instant (No delay)")
        self.delay_combo.append("3", "⏱  3 seconds delay")
        self.delay_combo.append("5", "⏱  5 seconds delay")
        self.delay_combo.append("10", "⏱  10 seconds delay")
        self.delay_combo.set_active(0)
        self.delay_combo.get_style_context().add_class("action-btn")
        left_box.pack_start(self.delay_combo, False, False, 0)

        # Section: Toggles
        lbl_opts = Gtk.Label(label="<b>ACTIONS ON CAPTURE</b>", use_markup=True, xalign=0)
        lbl_opts.set_margin_top(4)
        left_box.pack_start(lbl_opts, False, False, 0)

        self.chk_clip = Gtk.CheckButton(label="󰅍 Copy to clipboard")
        self.chk_clip.set_active(True)
        left_box.pack_start(self.chk_clip, False, False, 0)

        self.chk_save = Gtk.CheckButton(label="󰉋 Save to disk")
        self.chk_save.set_active(True)
        left_box.pack_start(self.chk_save, False, False, 0)

        self.chk_edit = Gtk.CheckButton(label="󰏪 Annotate in Swappy")
        self.chk_edit.set_active(False)
        left_box.pack_start(self.chk_edit, False, False, 0)

        # Spacer
