import argparse
import datetime
import glob
import os
import shutil
import subprocess
import sys
import threading
import time
import warnings

warnings.filterwarnings("ignore")

# Configure environment for X11 if needed
if "WAYLAND_DISPLAY" not in os.environ and "DISPLAY" not in os.environ:
    os.environ["DISPLAY"] = ":0"

if "WAYLAND_DISPLAY" not in os.environ and "XAUTHORITY" not in os.environ:
    for pat in ["/tmp/xauth_*", os.path.expanduser("~/.Xauthority")]:
        matches = sorted(glob.glob(pat), key=os.path.getmtime, reverse=True)
        if matches:
            os.environ["XAUTHORITY"] = matches[0]
            break

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, Gio, cairo

SHOT_DIR = os.path.expanduser("~/Pictures/Screenshots")
os.makedirs(SHOT_DIR, exist_ok=True)

# -----------------------------------------------------------------------------
# Core Utilities & Backend Functions
# -----------------------------------------------------------------------------

def is_wayland():
    return bool(os.environ.get("WAYLAND_DISPLAY"))


def get_timestamp_filename():
    ts = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    return os.path.join(SHOT_DIR, f"Screenshot_{ts}.png")


def copy_to_clipboard(filepath):
    if not os.path.isfile(filepath):
        return
    if is_wayland():
        if shutil.which("wl-copy"):
            try:
                with open(filepath, "rb") as f:
                    subprocess.run(["wl-copy", "--type", "image/png"], stdin=f, check=False)
            except Exception:
                pass
    else:
        # X11 clipboard
        xclip_bin = "/home/jacob/.local/bin/xclip"
        if not os.path.isfile(xclip_bin):
            xclip_bin = shutil.which("xclip") or "xclip"
        try:
            with open(filepath, "rb") as f:
                subprocess.Popen([xclip_bin, "-selection", "clipboard", "-t", "image/png"], stdin=f)
        except Exception:
            pass
        # Also store via Gtk Clipboard if mainloop active
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file(filepath)
            clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clip.set_image(pix)
            clip.store()
        except Exception:
            pass


def send_notification(filepath, mode_name="Screenshot"):
    if not shutil.which("notify-send"):
        return
    base = os.path.basename(filepath)
    try:
        subprocess.Popen([
            "notify-send",
            "-a", "HyprFrost Screenshot",
            "-i", filepath,
            f"Screenshot Captured ({mode_name})",
            f"Saved: {base}\nCopied to clipboard."
        ])
    except Exception:
        pass


def open_in_swappy(filepath):
    swappy_bin = "/home/jacob/.local/bin/swappy"
    if not os.path.isfile(swappy_bin):
        swappy_bin = shutil.which("swappy") or "swappy"
    if os.path.isfile(filepath):
        subprocess.Popen([swappy_bin, "-f", filepath])


def open_in_viewer(filepath):
    if os.path.isfile(filepath):
        subprocess.Popen(["xdg-open", filepath])


def open_folder(path=SHOT_DIR):
    subprocess.Popen(["thunar", path])


# -----------------------------------------------------------------------------
# Capture Implementations (Wayland & X11)
# -----------------------------------------------------------------------------

def capture_fullscreen_x11(target_path):
    display = Gdk.Display.get_default()
    if not display:
        raise RuntimeError("Could not open GDK display.")
    screen = display.get_default_screen()
    root = screen.get_root_window()
    sw = screen.get_width()
    sh = screen.get_height()
    pix = Gdk.pixbuf_get_from_window(root, 0, 0, sw, sh)
    if not pix:
        raise RuntimeError("Failed to capture root window.")
    pix.savev(target_path, "png", [], [])
    return target_path


def capture_window_x11(target_path):
    # Try Qtile IPC first
    geo = None
    try:
        from libqtile.command.client import InteractiveCommandClient
        client = InteractiveCommandClient()
        win = client.window.info()
        if win and win.get("width", 0) > 0 and win.get("height", 0) > 0:
            geo = (win["x"], win["y"], win["width"], win["height"])
    except Exception:
        pass

    # Fallback to xdotool
    if not geo and shutil.which("xdotool"):
        try:
            out = subprocess.check_output(["xdotool", "getactivewindow", "getwindowgeometry"], text=True)
            x = y = w = h = None
            for line in out.splitlines():
                line = line.strip()
                if line.startswith("Position:"):
                    parts = line.split()[1].split(",")
                    x, y = int(parts[0]), int(parts[1])
                elif line.startswith("Geometry:"):
                    parts = line.split()[1].split("x")
                    w, h = int(parts[0]), int(parts[1])
            if None not in (x, y, w, h) and w > 0 and h > 0:
                geo = (x, y, w, h)
        except Exception:
            pass

    display = Gdk.Display.get_default()
    screen = display.get_default_screen()
    root = screen.get_root_window()
    sw = screen.get_width()
    sh = screen.get_height()
    root_pix = Gdk.pixbuf_get_from_window(root, 0, 0, sw, sh)

    if geo:
        gx, gy, gw, gh = geo
        gx = max(0, min(gx, sw - 1))
        gy = max(0, min(gy, sh - 1))
        gw = min(gw, sw - gx)
        gh = min(gh, sh - gy)
        sub_pix = GdkPixbuf.Pixbuf.new_subpixbuf(root_pix, gx, gy, gw, gh)
        sub_pix.savev(target_path, "png", [], [])
    else:
        root_pix.savev(target_path, "png", [], [])
    return target_path


class X11SnipOverlay(Gtk.Window):
    def __init__(self, target_path, callback):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.target_path = target_path
        self.callback = callback

        self.set_app_paintable(True)
        visual = self.get_screen().get_rgba_visual() or self.get_screen().get_system_visual()
        self.set_visual(visual)

        display = Gdk.Display.get_default()
        screen = display.get_default_screen()
        self.sw = screen.get_width()
        self.sh = screen.get_height()
        self.set_default_size(self.sw, self.sh)
        self.move(0, 0)
        self.set_keep_above(True)

        root = screen.get_root_window()
        self.pixbuf = Gdk.pixbuf_get_from_window(root, 0, 0, self.sw, self.sh)

        self.start_x = None
        self.start_y = None
        self.cur_x = None
        self.cur_y = None
        self.is_dragging = False

        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.KEY_PRESS_MASK
        )

        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_button_press)
        self.connect("button-release-event", self.on_button_release)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("key-press-event", self.on_key_press)
        self.show_all()

    def on_draw(self, widget, ctx):
        if not self.pixbuf:
            return False

        # Draw full background snapshot
        Gdk.cairo_set_source_pixbuf(ctx, self.pixbuf, 0, 0)
        ctx.paint()

        # Dimmed Tokyo Night overlay
        ctx.set_source_rgba(0.08, 0.09, 0.14, 0.55)
        ctx.paint()

        if self.start_x is not None and self.cur_x is not None:
            x = min(self.start_x, self.cur_x)
            y = min(self.start_y, self.cur_y)
            w = abs(self.cur_x - self.start_x)
            h = abs(self.cur_y - self.start_y)

            if w > 2 and h > 2:
                # Reveal original image without dimming inside selection
                ctx.save()
                ctx.rectangle(x, y, w, h)
                ctx.clip()
                Gdk.cairo_set_source_pixbuf(ctx, self.pixbuf, 0, 0)
                ctx.paint()
                ctx.restore()

                # Neon border (Tokyo Night blue)
                ctx.set_source_rgba(0.48, 0.64, 0.97, 1.0)
                ctx.set_line_width(2.0)
                ctx.rectangle(x + 1, y + 1, w - 2, h - 2)
                ctx.stroke()

                # Dimensions badge
                badge_text = f"{int(w)} × {int(h)}"
                ctx.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                ctx.set_font_size(11)
                ext = ctx.text_extents(badge_text)
                bx = x + 6
                by = y - 8 if y > 30 else y + h + 18
                ctx.set_source_rgba(0.12, 0.14, 0.22, 0.88)
                ctx.rectangle(bx - 4, by - ext.height - 4, ext.width + 8, ext.height + 8)
                ctx.fill()
                ctx.set_source_rgba(0.48, 0.64, 0.97, 1.0)
                ctx.move_to(bx, by)
                ctx.show_text(badge_text)

        return False

    def on_button_press(self, widget, event):
        if event.button == 1:
            self.start_x = event.x
            self.start_y = event.y
            self.cur_x = event.x
            self.cur_y = event.y
            self.is_dragging = True
            self.queue_draw()
        elif event.button == 3:
            # Right click cancels
            self.destroy()
            self.callback(None)
        return True

    def on_motion(self, widget, event):
        if self.is_dragging:
            self.cur_x = event.x
            self.cur_y = event.y
            self.queue_draw()
        return True

    def on_button_release(self, widget, event):
        if event.button == 1 and self.is_dragging:
            self.is_dragging = False
            self.cur_x = event.x
            self.cur_y = event.y

            x = int(min(self.start_x, self.cur_x))
            y = int(min(self.start_y, self.cur_y))
            w = int(abs(self.cur_x - self.start_x))
            h = int(abs(self.cur_y - self.start_y))

            self.destroy()

            if w >= 5 and h >= 5 and self.pixbuf:
                sub = GdkPixbuf.Pixbuf.new_subpixbuf(self.pixbuf, x, y, w, h)
                sub.savev(self.target_path, "png", [], [])
                self.callback(self.target_path)
            else:
                self.callback(None)
        return True

    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            self.destroy()
            self.callback(None)
            return True
        return False


def execute_capture(mode="area", target_path=None, callback=None):
    if not target_path:
        target_path = get_timestamp_filename()

    if is_wayland():
        try:
            if mode == "full":
                subprocess.run(["grim", target_path], check=True)
                if callback:
                    callback(target_path)
                return target_path
            elif mode == "window":
                geo = subprocess.check_output(
                    "hyprctl activewindow -j | python3 -c 'import sys, json; d=json.load(sys.stdin); print(f\"{d[\"at\"][0]},{d[\"at\"][1]} {d[\"size\"][0]}x{d[\"size\"][1]}\")'",
                    shell=True,
                    text=True
                ).strip()
                if geo:
                    subprocess.run(["grim", "-g", geo, target_path], check=True)
                else:
                    subprocess.run(["grim", target_path], check=True)
                if callback:
                    callback(target_path)
                return target_path
            else:
                # Area mode with slurp
                geo = subprocess.check_output(
                    ["slurp", "-b", "1a1b2699", "-c", "7aa2f7ff", "-w", "2", "-d"],
                    text=True
                ).strip()
                if geo:
                    subprocess.run(["grim", "-g", geo, target_path], check=True)
                    if callback:
                        callback(target_path)
                    return target_path
                else:
                    if callback:
                        callback(None)
                    return None
        except Exception as e:
            if callback:
                callback(None)
            return None
    else:
        # X11 Mode
        try:
            if mode == "full":
                res = capture_fullscreen_x11(target_path)
                if callback:
                    callback(res)
                return res
            elif mode == "window":
                res = capture_window_x11(target_path)
                if callback:
                    callback(res)
                return res
            else:
                # Interactive Area Snip
                def on_done(path):
                    if callback:
                        callback(path)

                X11SnipOverlay(target_path, on_done)
                return target_path
        except Exception as e:
            if callback:
                callback(None)
            return None


