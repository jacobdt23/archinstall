        preview_frame.get_style_context().add_class("preview-container")
        right_box.pack_start(preview_frame, True, True, 0)

        self.preview_image = Gtk.Image()
        preview_frame.pack_start(self.preview_image, True, True, 8)

        # Image Details Label
        self.lbl_details = Gtk.Label(label="No screenshot selected", xalign=0.5)
        self.lbl_details.set_margin_bottom(6)
        preview_frame.pack_end(self.lbl_details, False, False, 0)

        # Action Toolbar under Preview
        act_toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        act_toolbar.set_halign(Gtk.Align.CENTER)
        right_box.pack_start(act_toolbar, False, False, 0)

        btn_copy = Gtk.Button(label="󰅍 Copy")
        btn_copy.get_style_context().add_class("action-btn")
        btn_copy.connect("clicked", lambda w: self.copy_selected())
        act_toolbar.pack_start(btn_copy, False, False, 0)

        btn_annotate = Gtk.Button(label="󰏪 Annotate")
        btn_annotate.get_style_context().add_class("action-btn")
        btn_annotate.connect("clicked", lambda w: self.annotate_selected())
        act_toolbar.pack_start(btn_annotate, False, False, 0)

        btn_view = Gtk.Button(label="󰈹 View")
        btn_view.get_style_context().add_class("action-btn")
        btn_view.connect("clicked", lambda w: self.view_selected())
        act_toolbar.pack_start(btn_view, False, False, 0)

        btn_delete = Gtk.Button(label="󰆴 Delete")
        btn_delete.get_style_context().add_class("action-btn")
        btn_delete.get_style_context().add_class("danger-btn")
        btn_delete.connect("clicked", lambda w: self.delete_selected())
        act_toolbar.pack_start(btn_delete, False, False, 0)

        # Recent Captures Scrolled List
        lbl_rec = Gtk.Label(label="<b>RECENT CAPTURES</b>", use_markup=True, xalign=0)
        right_box.pack_start(lbl_rec, False, False, 0)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_size_request(-1, 100)
        right_box.pack_start(scroller, False, False, 0)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-selected", self.on_history_selected)
        scroller.add(self.listbox)

    def set_mode(self, mode):
        self.current_mode = mode

    def refresh_history(self):
        # Clear listbox
        for row in self.listbox.get_children():
            self.listbox.remove(row)

        self.history_files = sorted(
            glob.glob(os.path.join(SHOT_DIR, "*.png")),
            key=os.path.getmtime,
            reverse=True
        )

        for path in self.history_files[:20]:
            row = Gtk.ListBoxRow()
            row.get_style_context().add_class("thumbnail-row")
            row.path = path

            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            box.set_margin_start(6)
            box.set_margin_end(6)
            box.set_margin_top(4)
            box.set_margin_bottom(4)

            # Thumbnail
            img = Gtk.Image()
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 40, 24, True)
                img.set_from_pixbuf(pix)
            except Exception:
                img.set_from_icon_name("image-x-generic", Gtk.IconSize.BUTTON)
            box.pack_start(img, False, False, 0)

            # Details
            name = os.path.basename(path)
            dt_str = datetime.datetime.fromtimestamp(os.path.getmtime(path)).strftime("%b %d, %I:%M %p")
            size_kb = os.path.getsize(path) / 1024
            size_str = f"{size_kb:.0f} KB" if size_kb < 1024 else f"{size_kb/1024:.1f} MB"

            txt = f"<b>{name}</b>  <small><span foreground='#565f89'>• {dt_str} • {size_str}</span></small>"
            lbl = Gtk.Label(use_markup=True, xalign=0)
            lbl.set_markup(txt)
            box.pack_start(lbl, True, True, 0)

            row.add(box)
            self.listbox.add(row)

        self.listbox.show_all()

        # Select the latest file if available
        if self.history_files:
            first_row = self.listbox.get_row_at_index(0)
            if first_row:
                self.listbox.select_row(first_row)
        else:
            self.preview_image.clear()
            self.lbl_details.set_text("No screenshots found in ~/Pictures/Screenshots")

    def on_history_selected(self, listbox, row):
        if not row or not hasattr(row, "path"):
            return
        self.load_preview(row.path)

    def load_preview(self, path):
        if not os.path.isfile(path):
            return
        self.selected_file = path
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file(path)
            pw, ph = pix.get_width(), pix.get_height()

            # Scale to fit container without distortion
            max_w, max_h = 420, 240
            scale = min(max_w / pw, max_h / ph, 1.0)
            target_w = max(1, int(pw * scale))
            target_h = max(1, int(ph * scale))
            scaled_pix = pix.scale_simple(target_w, target_h, GdkPixbuf.InterpType.BILINEAR)
            self.preview_image.set_from_pixbuf(scaled_pix)

            dt_str = datetime.datetime.fromtimestamp(os.path.getmtime(path)).strftime("%Y-%m-%d %I:%M:%S %p")
            size_kb = os.path.getsize(path) / 1024
            size_str = f"{size_kb:.0f} KB" if size_kb < 1024 else f"{size_kb/1024:.1f} MB"
            self.lbl_details.set_text(f"{os.path.basename(path)}  |  {pw} × {ph} px  |  {size_str}  |  {dt_str}")
        except Exception as e:
            self.lbl_details.set_text(f"Could not load image: {e}")

    def copy_selected(self):
        if self.selected_file:
            copy_to_clipboard(self.selected_file)
            send_notification(self.selected_file, "Copied")

    def annotate_selected(self):
        if self.selected_file:
            open_in_swappy(self.selected_file)

    def view_selected(self):
        if self.selected_file:
            open_in_viewer(self.selected_file)

    def delete_selected(self):
        if self.selected_file and os.path.isfile(self.selected_file):
            try:
                os.remove(self.selected_file)
            except Exception:
                pass
            self.refresh_history()

    def on_capture_clicked(self, widget):
        delay_sec = int(self.delay_combo.get_active_id() or "0")
        mode = self.current_mode

        # Hide window before capture
        self.hide()

        def do_capture():
            if delay_sec > 0:
                time.sleep(delay_sec)

            target = get_timestamp_filename()

            def finish_capture(result_path):
                GLib.idle_add(lambda: self.on_capture_finished(result_path))

            execute_capture(mode=mode, target_path=target, callback=finish_capture)

        threading.Thread(target=do_capture, daemon=True).start()

    def on_capture_finished(self, result_path):
        self.show_all()
        self.present()

        if result_path and os.path.isfile(result_path):
            if self.chk_clip.get_active():
                copy_to_clipboard(result_path)

            send_notification(result_path, self.current_mode.capitalize())

            if self.chk_edit.get_active():
                open_in_swappy(result_path)

            self.refresh_history()
            self.load_preview(result_path)


# -----------------------------------------------------------------------------
# CLI Entrypoint
# -----------------------------------------------------------------------------

def run_cli_snip(mode="area", annotate=False, output_path=None):
    target = output_path or get_timestamp_filename()

    def on_done(path):
        if path and os.path.isfile(path):
            copy_to_clipboard(path)
            send_notification(path, mode.capitalize())
            if annotate:
                open_in_swappy(path)
        Gtk.main_quit()

    execute_capture(mode=mode, target_path=target, callback=on_done)
    Gtk.main()


def main():
    parser = argparse.ArgumentParser(description="HyprFrost Universal Screenshot Utility")
    parser.add_argument(
        "mode",
        nargs="?",
        default="gui",
        choices=["gui", "menu", "area", "snip", "full", "screen", "window", "edit", "folder"],
        help="Capture mode or GUI launch"
    )
    parser.add_argument("-o", "--output", help="Output file path")
    parser.add_argument("-e", "--edit", action="store_true", help="Open in Swappy editor after capture")
    args = parser.parse_args()

    # Load CSS Styles
    screen = Gdk.Screen.get_default()
    if screen:
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(UI_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            screen,
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    if args.mode in ("area", "snip"):
        run_cli_snip(mode="area", annotate=args.edit, output_path=args.output)
    elif args.mode in ("full", "screen"):
        run_cli_snip(mode="full", annotate=args.edit, output_path=args.output)
    elif args.mode == "window":
        run_cli_snip(mode="window", annotate=args.edit, output_path=args.output)
    elif args.mode == "edit":
        run_cli_snip(mode="area", annotate=True, output_path=args.output)
    elif args.mode == "folder":
        open_folder()
    else:
        # Launch Full GUI Application
        app = ScreenshotApp()
        app.connect("destroy", Gtk.main_quit)
        app.show_all()
        Gtk.main()


if __name__ == "__main__":
    main()
