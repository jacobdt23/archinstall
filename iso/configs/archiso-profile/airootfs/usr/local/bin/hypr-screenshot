#!/usr/bin/env bash
# =============================================================================
# HyprFrost Screenshot Wrapper (Flameshot)
# Full Cross-WM Compatibility (Qtile X11 & Hyprland Wayland)
# =============================================================================

export LD_LIBRARY_PATH="/home/jacob/.local/lib:${LD_LIBRARY_PATH:-}"

if [ -n "$WAYLAND_DISPLAY" ]; then
    export XDG_CURRENT_DESKTOP="sway"
    export QT_QPA_PLATFORM="wayland;xcb"
fi

FLAMESHOT="/home/jacob/.local/bin/flameshot-bin"
if [ ! -x "$FLAMESHOT" ]; then
    FLAMESHOT="$(command -v flameshot || echo "/usr/bin/flameshot")"
fi

case "${1:-}" in
    full|screen)
        exec "$FLAMESHOT" full -c -p "${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
        ;;
    config|settings)
        exec "$FLAMESHOT" config
        ;;
    folder)
        exec thunar "${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
        ;;
    *)
        exec "$FLAMESHOT" gui
        ;;
esac
