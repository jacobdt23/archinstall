[Desktop Entry]
Version=1.5
Type=Application
Name=Orbit View
GenericName=Image Viewer
Comment=Fast image viewer with folder slideshow, zoom, rotation, and metadata
Icon=image-x-generic
Exec=orbit-view %f
TryExec=orbit-view
Terminal=false
Categories=Graphics;Viewer;GTK;
Keywords=image;photo;picture;viewer;gallery;slideshow;orbit;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/svg+xml;image/tiff;image/avif;
StartupNotify=true
StartupWMClass=dev.orbit.View
SingleMainWindow=false
DBusActivatable=false
OnlyShowIn=X-Hyprland-Standalone;X-Orbit-Qtile;
